// EdsDown – user interface (Slint), in the layout of NetNOC / NetLAB:
// a side column (total speed, active downloads, today, queues), pills on top,
// the downloads as glass cards (running) and compact rows (finished), and a
// floating dock of round buttons. Two themes: NetLAB dark and light.

import { LineEdit, SpinBox, ComboBox, ListView, TabWidget, TextEdit, Palette } from "std-widgets.slint";
import { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme, ThemedWindow, P, Icon, G, TypeIcon, BigTypeIcon, ToolBtn, ToolSeparator, TreeItem, HeaderCell, Cell, MenuEntry, MenuSep, MenuLabel, Glyph, Button, CheckBox, MenuFrame, Ico, Kinds, KindBadge, RoundBtn, Pill, Chip, Glass, SectionTitle, Bar } from "common.slint";
export { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme }
export { BrowserRow } from "dialogs.slint";
export { ColumnsDialog, CategoryDialog, FindDialog, PropertiesDialog, DuplicateDialog, CountdownDialog, SchedulerDialog, GrabberDialog, TipDialog, RefreshDialog, SettingsDialog, PlaylistDialog, BrowserDialog, AboutDialog, UpdateDialog } from "dialogs.slint";

// ------------------------------------------------------------------ download menu

// Right click on a card or a row.
component RowMenu inherits PopupWindow {
    in property <DownloadRow> data;
    in property <[QueueRow]> queues;
    in property <int> sel-count;
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    property <bool> done: root.data.state == 3;
    property <bool> can-resume: root.data.state == 2 || root.data.state == 4;
    property <bool> can-stop: root.data.state == 0 || root.data.state == 1;
    width: 270px;
    height: list.preferred-height + 2px;
    MenuFrame {
        width: parent.width;
        height: parent.height;
        list := VerticalLayout {
            padding: 6px;
            if root.sel-count > 1: MenuLabel {
                text: @tr("{} downloads selected", root.sel-count);
            }
            MenuEntry {
                text: root.done ? @tr("Open") : @tr("Show download progress");
                glyph: root.done ? "openwith" : "progress";
                bold: true;
                clicked => {
                    root.activated();
                }
            }
            MenuEntry {
                text: @tr("Open with…");
                glyph: "openwith";
                enabled: root.done;
                clicked => {
                    root.action("openwith");
                }
            }
            MenuEntry {
                text: @tr("Open folder");
                glyph: "folder";
                clicked => {
                    root.action("folder");
                }
            }
            MenuSep { }
            MenuEntry {
                text: @tr("Resume download");
                glyph: "play";
                glyph-color: Theme.green;
                enabled: root.can-resume || root.sel-count > 1;
                clicked => {
                    root.action("resume");
                }
            }
            MenuEntry {
                text: @tr("Stop download");
                glyph: "pause";
                glyph-color: Theme.orange;
                enabled: root.can-stop || root.sel-count > 1;
                clicked => {
                    root.action("stop");
                }
            }
            MenuEntry {
                text: @tr("Redownload");
                glyph: "redo";
                clicked => {
                    root.action("restart");
                }
            }
            MenuEntry {
                text: @tr("Refresh download address…");
                glyph: "refresh";
                enabled: !root.done;
                clicked => {
                    root.action("refresh");
                }
            }
            MenuEntry {
                text: @tr("Move / Rename…");
                glyph: "edit";
                clicked => {
                    root.action("move");
                }
            }
            MenuSep { }
            MenuLabel {
                text: @tr("Move to queue");
            }
            for q in root.queues: MenuEntry {
                text: q.name;
                glyph: "queue";
                checked: root.data.queue == q.id;
                clicked => {
                    root.move-to-queue(q.id);
                }
            }
            MenuEntry {
                text: @tr("Delete from queue");
                glyph: "minus";
                enabled: root.data.queue != "";
                clicked => {
                    root.move-to-queue(-1);
                }
            }
            MenuSep { }
            MenuEntry {
                text: @tr("Copy address");
                glyph: "copy";
                clicked => {
                    root.action("copy");
                }
            }
            MenuEntry {
                text: @tr("Check file (SHA-256)");
                glyph: "hash";
                enabled: root.done;
                clicked => {
                    root.action("sha256");
                }
            }
            MenuEntry {
                text: @tr("Properties");
                glyph: "info";
                clicked => {
                    root.action("properties");
                }
            }
            MenuSep { }
            MenuEntry {
                text: @tr("Remove");
                glyph: "delete";
                glyph-color: Theme.red;
                clicked => {
                    root.action("delete");
                }
            }
        }
    }
}

// ------------------------------------------------------------------ cards and rows

// A download that is not finished: a glass card like NetNOC's destinations.
component DownloadCard inherits Rectangle {
    in property <DownloadRow> data;
    in property <bool> selected;
    in property <[QueueRow]> queues;
    in property <int> sel-count;
    callback pick(bool, bool);
    callback right-pick();
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    property <bool> running: root.data.state == 1;
    property <bool> queued: root.data.state == 0;
    property <bool> failed: root.data.state == 4;
    property <color> state-color: root.running ? Theme.orange : root.failed ? Theme.red : root.queued ? Theme.blue : Theme.muted;
    property <length> menu-x;
    property <length> menu-y;
    border-radius: Theme.r-card;
    background: Theme.glass;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? #4f8dffcc : ta.has-hover ? (Theme.dark ? #ffffff2e : #ffffffff) : Theme.stroke;
    drop-shadow-blur: root.selected ? 22px : 18px;
    drop-shadow-color: root.selected ? #4f8dff4d : Theme.shadow;
    drop-shadow-offset-y: root.selected ? 0px : 6px;
    clip: true;
    // the big faded icon, like the logos on NetNOC's cards
    Ico {
        x: parent.width - 104px;
        y: -14px;
        width: 128px;
        height: 128px;
        kind: root.data.kind;
        tint: Kinds.tint(root.data.kind).with-alpha(Theme.dark ? 0.10 : 0.13);
        weight: 1.4;
    }
    ta := TouchArea {
        double-clicked => {
            root.activated();
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.pick(ev.modifiers.control, ev.modifiers.shift);
            }
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.right-pick();
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
    }
    VerticalLayout {
        padding: 16px;
        padding-bottom: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            KindBadge {
                kind: root.data.kind;
                width: 40px;
                height: 40px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.data.name;
                    font-size: 13px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.data.size != "" ? root.data.size + "  ·  " + root.data.status : root.data.status;
                    font-size: 11px * Theme.font-scale;
                    color: root.failed ? Theme.red : Theme.muted;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        Bar {
            value: root.data.progress;
            tint: root.state-color;
        }
        HorizontalLayout {
            spacing: 8px;
            RoundBtn {
                size: 32px;
                icon: root.running || root.queued ? "pause" : "play";
                label: root.running || root.queued ? @tr("Stop download") : @tr("Resume download");
                clicked => {
                    root.action(root.running || root.queued ? "stop" : "resume");
                }
            }
            if root.data.speed != "": Pill {
                height: 32px;
                icon: "download";
                text: root.data.speed;
                state: "ok";
            }
            if root.data.eta != "": Pill {
                height: 32px;
                icon: "clock";
                text: root.data.eta;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: root.data.progress > 0 ? round(root.data.progress * 100) + "%" : "";
                vertical-alignment: center;
                font-size: 18px * Theme.font-scale;
                font-weight: 300;
                color: root.state-color;
            }
        }
    }
    menu := RowMenu {
        x: root.menu-x;
        y: root.menu-y;
        data: root.data;
        queues: root.queues;
        sel-count: root.sel-count;
        activated => {
            root.activated();
        }
        action(a) => {
            root.action(a);
        }
        move-to-queue(q) => {
            root.move-to-queue(q);
        }
    }
}

// A finished download: one compact glass row.
component DoneRow inherits Rectangle {
    in property <DownloadRow> data;
    in property <bool> selected;
    in property <[QueueRow]> queues;
    in property <int> sel-count;
    callback pick(bool, bool);
    callback right-pick();
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    // dragging the file out of the program (onto the desktop, a folder…)
    callback drag-out();
    property <bool> dragged-out;
    property <length> menu-x;
    property <length> menu-y;
    height: max(58px, 58px * Theme.font-scale);
    tile := Rectangle {
        x: 0;
        y: 3px;
        width: parent.width;
        height: parent.height - 6px;
        border-radius: 16px;
        background: root.selected ? Theme.select : ta.has-hover ? Theme.btn : Theme.tile;
        border-width: 1px;
        border-color: root.selected ? Theme.select-line : Theme.dark ? #ffffff0d : #ffffff80;
        ta := TouchArea {
            double-clicked => {
                root.activated();
            }
            moved => {
                if (self.pressed && !root.dragged-out && abs(self.mouse-x - self.pressed-x) > 14px) {
                    root.dragged-out = true;
                    root.drag-out();
                }
            }
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                    root.dragged-out = false;
                    root.pick(ev.modifiers.control, ev.modifiers.shift);
                }
                if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                    root.right-pick();
                    root.menu-x = self.mouse-x;
                    root.menu-y = self.mouse-y;
                    menu.show();
                }
            }
        }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                KindBadge {
                    kind: root.data.kind;
                    width: 34px;
                    height: 34px;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.data.name;
                    font-size: 12.5px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.data.save-to;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
            Text {
                text: root.data.size;
                width: 84px;
                vertical-alignment: center;
                horizontal-alignment: right;
                font-size: 12px * Theme.font-scale;
                font-weight: 600;
                color: Theme.text-2;
            }
            Text {
                text: root.data.last-try;
                width: 130px;
                vertical-alignment: center;
                horizontal-alignment: right;
                font-size: 11px * Theme.font-scale;
                color: Theme.muted;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                RoundBtn {
                    size: 32px;
                    icon: "folder";
                    label: @tr("Open folder");
                    clicked => {
                        root.action("folder");
                    }
                }
            }
        }
    }
    menu := RowMenu {
        x: root.menu-x;
        y: root.menu-y + tile.y;
        data: root.data;
        queues: root.queues;
        sel-count: root.sel-count;
        activated => {
            root.activated();
        }
        action(a) => {
            root.action(a);
        }
        move-to-queue(q) => {
            root.move-to-queue(q);
        }
    }
}

// One running download in the side column.
component SideItem inherits Rectangle {
    in property <DownloadRow> data;
    callback clicked();
    height: 44px;
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        spacing: 6px;
        alignment: center;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.data.name;
                font-size: 12px * Theme.font-scale;
                color: Theme.side-text;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.data.speed;
                font-size: 11px * Theme.font-scale;
                color: Theme.dark ? Theme.muted : #ffffffcc;
            }
        }
        Bar {
            height: 4px;
            value: root.data.progress;
            tint: Theme.orange;
        }
    }
}

// A queue in the side column: name, count, start / stop.
component QueueItem inherits Rectangle {
    in property <QueueRow> q;
    in property <bool> selected;
    callback clicked();
    callback toggle();
    callback edit();
    height: 40px;
    border-radius: 12px;
    background: root.selected ? Theme.select : ta.has-hover ? Theme.btn : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.edit();
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 10px;
        Ico {
            y: (parent.height - 18px) / 2;
            kind: "queue";
            width: 18px;
            height: 18px;
            tint: root.q.running ? Theme.green : Theme.dark ? Theme.muted : #ffffffcc;
        }
        Text {
            text: root.q.name;
            vertical-alignment: center;
            font-size: 12px * Theme.font-scale;
            color: Theme.side-text;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.q.count > 0: Text {
            text: root.q.count;
            vertical-alignment: center;
            font-size: 11px * Theme.font-scale;
            font-weight: 600;
            color: Theme.dark ? Theme.muted : #ffffffcc;
        }
        VerticalLayout {
            alignment: center;
            RoundBtn {
                size: 30px;
                icon: root.q.running ? "stop" : "play";
                active: root.q.running;
                label: root.q.running ? @tr("Stop queue") : @tr("Start queue");
                clicked => {
                    root.toggle();
                }
            }
        }
    }
}

// A small "number + label" in the side column ("3 finished").
component Stat inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    spacing: 0px;
    Text {
        text: root.value;
        font-size: 22px * Theme.font-scale;
        font-weight: 300;
        color: Theme.side-text;
    }
    Text {
        text: root.label;
        font-size: 11px * Theme.font-scale;
        color: Theme.dark ? Theme.muted : #ffffffcc;
    }
}

// An entry of the "⋯" menu that opens another page of it.
component PageEntry inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <string> value;
    callback clicked();
    height: 32px;
    border-radius: 10px;
    background: ta.has-hover ? Theme.btn-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Glyph {
            y: (parent.height - 16px) / 2;
            kind: root.glyph;
            tint: Theme.btn-ico;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 12px * Theme.font-scale;
            color: Theme.text;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.value != "": Text {
            text: root.value;
            vertical-alignment: center;
            horizontal-alignment: right;
            max-width: 110px;
            font-size: 11px * Theme.font-scale;
            color: Theme.muted;
            overflow: elide;
        }
        Glyph {
            y: (parent.height - 16px) / 2;
            kind: "chevron-right";
            tint: Theme.muted;
        }
    }
}

// ------------------------------------------------------------------ main window

export component MainWindow inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("EdsDown");
    // Options > Appearance > Background picture (instead of the waves)
    in property <image> bg-image;
    in property <bool> has-bg-image;
    preferred-width: 1180px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 580px;

    in property <[DownloadRow]> rows;
    // the same rows, split: not finished (cards) and finished (compact rows)
    in property <[DownloadRow]> active-rows;
    in property <[DownloadRow]> done-rows;
    // the side column: running downloads (a few), total speed, the day
    in property <[DownloadRow]> side-rows;
    in property <string> speed-value: "0";
    in property <string> speed-unit: "KB/s";
    in property <string> speed-caption;
    // the speed of the last minute, as path commands on a 100×40 grid
    in property <string> spark-line: "M 0 40 L 100 40";
    in property <string> spark-area: "M 0 40 L 100 40 Z";
    in property <string> today-count: "0";
    in property <string> today-bytes: "0 B";
    in property <string> date-text;
    in property <int> running-count;
    // the browser add-in talked to the program in the last minutes
    in property <bool> browser-on;
    in property <[QueueRow]> queues;
    in property <[CatRow]> categories;
    // counts: all, unfinished, finished
    in property <string> count-all;
    in property <string> count-unfinished;
    in property <string> count-finished;
    in-out property <int> selected-id: -1;
    // "all", "cat:Video", "unfinished", "unf:Video", "finished", "fin:Video", "queue:3"
    in-out property <string> view: "all";
    in-out property <string> search;
    in property <string> status-text;
    in property <string> limiter-text;
    in property <int> selected-state: -1;
    // multiple selection: how many, and whether any can be resumed / stopped
    in property <int> sel-count;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <int> current-queue: 1;
    in property <bool> limiter-on;
    in property <bool> hide-categories;
    in property <string> sort-by: "date";
    in property <bool> sort-desc: true;
    // when all downloads finish: 0 nothing, 1 shut down, 2 sleep, 3 exit, 4 hibernate
    in property <int> all-done: 0;
    in property <Cols> cols: { q: true, size: true, status: true, eta: true, speed: true, last: true, desc: true };
    in property <bool> toolbar-small;
    in property <string> language: "en";
    in-out property <bool> open-all: true;
    in-out property <bool> open-unf: false;
    in-out property <bool> open-fin: false;
    in-out property <bool> open-queues: true;
    in property <[ColDef]> columns;

    callback add-url();
    callback add-batch();
    callback add-batch-clipboard();
    callback resume(int);
    callback pause(int);
    callback resume-all();
    callback stop-all();
    callback delete(int);
    callback delete-completed();
    callback open-settings(int);
    callback open-scheduler();
    callback open-limiter();
    callback toggle-limiter();
    callback start-queue(int);
    callback stop-queue(int);
    callback new-queue();
    callback edit-queue(int);
    callback delete-queue(int);
    callback view-changed(string);
    callback search-changed();
    callback sort(string);
    callback row-activated(int);
    callback row-clicked(int, bool, bool);
    callback row-right(int);
    callback row-drag(int, int);
    callback row-drag-out(int);
    callback column-resized(int, length);
    callback column-dropped(int, length);
    callback columns-changed();
    callback select-all();
    callback row-action(int, string);
    callback row-to-queue(int, int);
    callback open-download-folder();
    callback export-list(string);
    callback import-list(string);
    callback set-theme(int);
    callback set-language(string);
    callback toggle-categories();
    callback set-toolbar-small(bool);
    callback open-columns();
    callback update-tools();
    callback check-app-update();
    callback set-all-done(int);
    callback add-category();
    callback category-props(string);
    callback delete-category(string);
    callback find();
    callback find-next();
    callback grabber();
    callback playlist();
    callback browsers();
    callback tips();
    callback about();
    callback quit();

    function set-view(v: string) {
        root.view = v;
        root.view-changed(v);
    }
    pure function done-text(n: int) -> string {
        if (n == 1) { return @tr("Shut down"); }
        if (n == 2) { return @tr("Sleep"); }
        if (n == 3) { return @tr("Exit EdsDown"); }
        if (n == 4) { return @tr("Hibernate"); }
        return @tr("Do nothing");
    }
    pure function sort-text(k: string) -> string {
        if (k == "added") { return @tr("By order of addition"); }
        if (k == "name") { return @tr("File name"); }
        if (k == "size") { return @tr("Size"); }
        if (k == "status") { return @tr("Status"); }
        if (k == "eta") { return @tr("Time left"); }
        if (k == "speed") { return @tr("Transfer rate"); }
        return @tr("Last try date");
    }

    // ---- background: NetNOC's waves (or the picture chosen in Options)
    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.has-bg-image ? root.bg-image : Theme.dark ? @image-url("bg-netlab-dark.jpg") : @image-url("bg-netlab-light.jpg");
        image-fit: cover;
    }

    // ---- popups
    property <string> page: "main";
    more-menu := PopupWindow {
        x: root.width - self.width - 22px;
        y: 72px;
        width: 340px;
        height: min(more-list.preferred-height + 2px, root.height - 90px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        MenuFrame {
            width: parent.width;
            height: parent.height;
            clip: true;
            Flickable {
                content-height: more-list.preferred-height;
                more-list := VerticalLayout {
                    padding: 6px;
                    if root.page == "main": VerticalLayout {
                        MenuEntry {
                            text: @tr("Resume all");
                            glyph: "play";
                            glyph-color: Theme.green;
                            clicked => {
                                root.resume-all();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Stop all");
                            glyph: "stopall";
                            glyph-color: Theme.orange;
                            clicked => {
                                root.stop-all();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Delete all completed");
                            glyph: "deletedone";
                            glyph-color: Theme.red;
                            clicked => {
                                root.delete-completed();
                                more-menu.close();
                            }
                        }
                        MenuSep { }
                        MenuEntry {
                            text: @tr("Add batch download from clipboard");
                            glyph: "copy";
                            clicked => {
                                root.add-batch-clipboard();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Find…   Ctrl+F");
                            glyph: "search";
                            clicked => {
                                root.find();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Open download folder");
                            glyph: "folder";
                            clicked => {
                                root.open-download-folder();
                                more-menu.close();
                            }
                        }
                        PageEntry {
                            text: @tr("Export / Import");
                            glyph: "export";
                            clicked => {
                                root.page = "io";
                            }
                        }
                        MenuSep { }
                        PageEntry {
                            text: @tr("When all downloads finish");
                            glyph: "power";
                            value: root.done-text(root.all-done);
                            clicked => {
                                root.page = "done";
                            }
                        }
                        PageEntry {
                            text: @tr("Arrange files");
                            glyph: "sort";
                            value: root.sort-text(root.sort-by);
                            clicked => {
                                root.page = "sort";
                            }
                        }
                        PageEntry {
                            text: @tr("Language");
                            glyph: "language";
                            clicked => {
                                root.page = "lang";
                            }
                        }
                        MenuEntry {
                            text: @tr("Appearance…");
                            glyph: "sun";
                            clicked => {
                                root.open-settings(9);
                                more-menu.close();
                            }
                        }
                        MenuSep { }
                        MenuEntry {
                            text: @tr("Add EdsDown to my browser…");
                            glyph: "browser";
                            clicked => {
                                root.browsers();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Tip of the day…");
                            glyph: "bulb";
                            clicked => {
                                root.tips();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Check for updates");
                            glyph: "refresh";
                            clicked => {
                                root.check-app-update();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Check for updates (video downloader)");
                            glyph: "video";
                            clicked => {
                                root.update-tools();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("About EdsDown");
                            glyph: "info";
                            clicked => {
                                root.about();
                                more-menu.close();
                            }
                        }
                        MenuSep { }
                        MenuEntry {
                            text: @tr("Exit");
                            glyph: "exit";
                            glyph-color: Theme.red;
                            clicked => {
                                root.quit();
                                more-menu.close();
                            }
                        }
                    }
                    if root.page != "main": MenuEntry {
                        text: @tr("Back");
                        glyph: "chevron-down";
                        bold: true;
                        clicked => {
                            root.page = "main";
                        }
                    }
                    if root.page != "main": MenuSep { }
                    if root.page == "io": VerticalLayout {
                        MenuLabel {
                            text: @tr("Export");
                        }
                        MenuEntry {
                            text: @tr("To download list file (.ef2)…");
                            glyph: "export";
                            clicked => {
                                root.export-list("ef2");
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("To text file…");
                            glyph: "text";
                            clicked => {
                                root.export-list("txt");
                                more-menu.close();
                            }
                        }
                        MenuLabel {
                            text: @tr("Import");
                        }
                        MenuEntry {
                            text: @tr("From download list file (.ef2)…");
                            glyph: "import";
                            clicked => {
                                root.import-list("ef2");
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("From text file…");
                            glyph: "text";
                            clicked => {
                                root.import-list("txt");
                                more-menu.close();
                            }
                        }
                    }
                    if root.page == "done": VerticalLayout {
                        for o in [0, 1, 2, 4, 3]: MenuEntry {
                            text: root.done-text(o);
                            glyph: o == 0 ? "close" : o == 3 ? "exit" : "power";
                            checked: root.all-done == o;
                            clicked => {
                                root.set-all-done(o);
                                more-menu.close();
                            }
                        }
                    }
                    if root.page == "sort": VerticalLayout {
                        for k in ["added", "name", "size", "status", "eta", "speed", "date"]: MenuEntry {
                            text: root.sort-text(k);
                            glyph: "sort";
                            checked: root.sort-by == k;
                            clicked => {
                                root.sort(k);
                                more-menu.close();
                            }
                        }
                    }
                    if root.page == "lang": VerticalLayout {
                        for l in [
                            { code: "en", name: "English" },
                            { code: "pt", name: "Português" },
                            { code: "es", name: "Español" },
                            { code: "fr", name: "Français" },
                            { code: "de", name: "Deutsch" },
                            { code: "tr", name: "Türkçe" },
                            { code: "ru", name: "Русский" },
                            { code: "ar", name: "العربية" }
                        ]: MenuEntry {
                            text: l.name;
                            glyph: "language";
                            checked: root.language == l.code;
                            clicked => {
                                root.set-language(l.code);
                                more-menu.close();
                            }
                        }
                    }
                }
            }
        }
    }

    // right click on a category chip
    property <string> cat-target;
    property <bool> cat-builtin;
    property <length> cat-x;
    property <length> cat-y;
    cat-menu := PopupWindow {
        x: root.cat-x;
        y: root.cat-y;
        width: 230px;
        height: cat-list.preferred-height + 2px;
        MenuFrame {
            width: parent.width;
            height: parent.height;
            cat-list := VerticalLayout {
                padding: 6px;
                MenuEntry {
                    text: @tr("Properties");
                    glyph: "edit";
                    enabled: root.cat-target != "";
                    clicked => {
                        root.category-props(root.cat-target);
                    }
                }
                MenuEntry {
                    text: @tr("Delete");
                    glyph: "delete";
                    glyph-color: Theme.red;
                    enabled: root.cat-target != "" && !root.cat-builtin;
                    clicked => {
                        root.delete-category(root.cat-target);
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("New category…");
                    glyph: "plus";
                    clicked => {
                        root.add-category();
                    }
                }
            }
        }
    }

    // right click on a queue
    property <int> q-target;
    property <length> q-x;
    property <length> q-y;
    q-menu := PopupWindow {
        x: root.q-x;
        y: root.q-y;
        width: 230px;
        height: q-list.preferred-height + 2px;
        MenuFrame {
            width: parent.width;
            height: parent.height;
            q-list := VerticalLayout {
                padding: 6px;
                MenuEntry {
                    text: @tr("Start queue");
                    glyph: "play";
                    glyph-color: Theme.green;
                    clicked => {
                        root.start-queue(root.q-target);
                    }
                }
                MenuEntry {
                    text: @tr("Stop queue");
                    glyph: "stop";
                    glyph-color: Theme.orange;
                    clicked => {
                        root.stop-queue(root.q-target);
                    }
                }
                MenuEntry {
                    text: @tr("Edit");
                    glyph: "edit";
                    clicked => {
                        root.edit-queue(root.q-target);
                    }
                }
                MenuEntry {
                    text: @tr("Delete");
                    glyph: "delete";
                    glyph-color: Theme.red;
                    enabled: root.q-target != 1;
                    clicked => {
                        root.delete-queue(root.q-target);
                    }
                }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                root.select-all();
                return accept;
            }
            if (event.text == Key.Delete && root.selected-id >= 0) {
                root.delete(root.selected-id);
                return accept;
            }
            if (event.text == Key.Return && root.selected-id >= 0) {
                root.row-activated(root.selected-id);
                return accept;
            }
            if (event.text == Key.F3) {
                root.find-next();
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                root.find();
                return accept;
            }
            if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                root.add-url();
                return accept;
            }
            if (event.modifiers.control && (event.text == "b" || event.text == "B")) {
                root.add-batch();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            padding: 18px;
            padding-bottom: 0px;
            spacing: 18px;

            // ================================================ side column
            VerticalLayout {
                width: 300px;
                spacing: 14px;
                padding-bottom: 18px;
                VerticalLayout {
                    height: 50px;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.date-text;
                        horizontal-alignment: center;
                        font-size: 19px * Theme.font-scale;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Text {
                        text: "EdsDown";
                        horizontal-alignment: center;
                        font-size: 12.5px * Theme.font-scale;
                        color: Theme.muted;
                    }
                }
                Glass {
                    vertical-stretch: 1;
                    radius: 30px;
                    background: Theme.side;
                    clip: true;
                    Flickable {
                        content-height: side.preferred-height;
                        side := VerticalLayout {
                            padding: 22px;
                            spacing: 14px;
                            // total speed, big like NetNOC's clock
                            VerticalLayout {
                                spacing: 0px;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: root.speed-value;
                                        font-size: 58px * Theme.font-scale;
                                        font-weight: 300;
                                        color: Theme.side-text;
                                    }
                                    VerticalLayout {
                                        alignment: end;
                                        padding-bottom: 12px;
                                        Text {
                                            text: root.speed-unit;
                                            font-size: 16px * Theme.font-scale;
                                            font-weight: 600;
                                            color: Theme.dark ? Theme.muted : #ffffffcc;
                                        }
                                    }
                                }
                                Text {
                                    text: root.speed-caption;
                                    horizontal-alignment: center;
                                    font-size: 12px * Theme.font-scale;
                                    color: Theme.dark ? Theme.muted : #ffffffcc;
                                }
                            }
                            // the last minute
                            Rectangle {
                                height: 64px;
                                Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: 100;
                                    viewbox-height: 40;
                                    commands: root.spark-area;
                                    fill: @linear-gradient(180deg, #f59e2e66 0%, #f59e2e00 100%);
                                    stroke: transparent;
                                }
                                Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: 100;
                                    viewbox-height: 40;
                                    commands: root.spark-line;
                                    fill: transparent;
                                    stroke: #ffb35c;
                                    stroke-width: 2px;
                                    stroke-line-cap: round;
                                    stroke-line-join: round;
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.dark ? #ffffff1f : #ffffff59;
                            }
                            SectionTitle {
                                text: @tr("DOWNLOADING NOW");
                                color: Theme.dark ? Theme.muted : #ffffffcc;
                            }
                            for r in root.side-rows: SideItem {
                                data: r;
                                clicked => {
                                    root.row-activated(r.id);
                                }
                            }
                            if root.side-rows.length == 0: Text {
                                text: @tr("Nothing downloading right now ✓");
                                font-size: 12px * Theme.font-scale;
                                color: Theme.dark ? Theme.text-2 : #ffffffe6;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.dark ? #ffffff1f : #ffffff59;
                            }
                            SectionTitle {
                                text: @tr("TODAY");
                                color: Theme.dark ? Theme.muted : #ffffffcc;
                            }
                            HorizontalLayout {
                                spacing: 18px;
                                Stat {
                                    value: root.today-count;
                                    label: @tr("finished");
                                }
                                Stat {
                                    value: root.today-bytes;
                                    label: @tr("downloaded");
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.dark ? #ffffff1f : #ffffff59;
                            }
                            HorizontalLayout {
                                SectionTitle {
                                    text: @tr("QUEUES");
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: Theme.dark ? Theme.muted : #ffffffcc;
                                }
                                RoundBtn {
                                    size: 28px;
                                    icon: "plus";
                                    label: @tr("New queue");
                                    clicked => {
                                        root.new-queue();
                                    }
                                }
                            }
                            for q in root.queues: QueueItem {
                                q: q;
                                selected: root.view == "queue:" + q.id;
                                clicked => {
                                    root.set-view(root.view == "queue:" + q.id ? "all" : "queue:" + q.id);
                                }
                                edit => {
                                    root.edit-queue(q.id);
                                }
                                toggle => {
                                    if (q.running) {
                                        root.stop-queue(q.id);
                                    } else {
                                        root.start-queue(q.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================================================ main column
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 14px;
                // ---- top: pills, search, theme, menu
                HorizontalLayout {
                    height: 50px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Pill {
                                state: root.running-count > 0 ? "ok" : "";
                                text: root.running-count > 0 ? @tr("{} downloading", root.running-count) : @tr("Idle");
                            }
                            Pill {
                                icon: "limiter";
                                state: root.limiter-on ? "warn" : "";
                                text: root.limiter-on ? @tr("Limiter on") : @tr("No speed limit");
                                clickable: true;
                                clicked => {
                                    root.toggle-limiter();
                                }
                            }
                            Pill {
                                icon: "browser";
                                state: root.browser-on ? "ok" : "";
                                text: root.browser-on ? @tr("Browser connected") : @tr("Browser not connected");
                                clickable: true;
                                clicked => {
                                    root.browsers();
                                }
                            }
                            if root.all-done != 0: Pill {
                                icon: "power";
                                state: "warn";
                                text: root.done-text(root.all-done);
                                clickable: true;
                                clicked => {
                                    root.set-all-done(0);
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    // search
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 230px;
                            height: 38px;
                            border-radius: 19px;
                            background: si.has-focus ? Theme.btn-hover : Theme.btn;
                            border-width: 1px;
                            border-color: si.has-focus ? #4f8dffaa : Theme.stroke;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 8px;
                                Ico {
                                    y: (parent.height - 16px) / 2;
                                    kind: "search";
                                    width: 16px;
                                    height: 16px;
                                    tint: Theme.muted;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    si := TextInput {
                                        width: parent.width;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        single-line: true;
                                        text <=> root.search;
                                        color: Theme.text;
                                        font-size: 12.5px * Theme.font-scale;
                                        edited => {
                                            root.search-changed();
                                        }
                                    }
                                    if si.text == "": Text {
                                        width: parent.width;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        text: @tr("Filter the list…");
                                        font-size: 12.5px * Theme.font-scale;
                                        color: Theme.muted;
                                    }
                                }
                                if root.search != "": Ico {
                                    y: (parent.height - 14px) / 2;
                                    kind: "close";
                                    width: 14px;
                                    height: 14px;
                                    tint: Theme.muted;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search = "";
                                            root.search-changed();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        RoundBtn {
                            size: 46px;
                            icon: Theme.dark ? "moon" : "sun";
                            accent: true;
                            label: Theme.dark ? @tr("NetLAB light") : @tr("NetLAB dark");
                            label-above: false;
                            clicked => {
                                root.set-theme(Theme.dark ? 10 : 9);
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 46px;
                            height: 46px;
                            border-radius: 23px;
                            background: @linear-gradient(135deg, #7f6bff 0%, #4f8dff 100%);
                            drop-shadow-blur: 14px;
                            drop-shadow-color: #4f8dff55;
                            drop-shadow-offset-y: 4px;
                            Ico {
                                kind: "more";
                                width: 22px;
                                height: 22px;
                                tint: #ffffff;
                                weight: 3;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.page = "main";
                                    more-menu.show();
                                }
                            }
                        }
                    }
                }

                // ---- filters
                HorizontalLayout {
                    height: 30px;
                    spacing: 8px;
                    Flickable {
                        horizontal-stretch: 1;
                        content-width: chips.preferred-width;
                        interactive: true;
                        chips := HorizontalLayout {
                            spacing: 8px;
                            Chip {
                                text: @tr("All");
                                count: root.count-all;
                                selected: root.view == "all";
                                clicked => {
                                    root.set-view("all");
                                }
                            }
                            Chip {
                                icon: "download";
                                text: @tr("In progress");
                                count: root.count-unfinished;
                                selected: root.view == "unfinished";
                                clicked => {
                                    root.set-view("unfinished");
                                }
                            }
                            Chip {
                                icon: "check";
                                text: @tr("Finished");
                                count: root.count-finished;
                                selected: root.view == "finished";
                                clicked => {
                                    root.set-view("finished");
                                }
                            }
                            Rectangle {
                                width: 1px;
                                background: Theme.rule;
                            }
                            for c in root.categories: Chip {
                                icon: c.kind;
                                text: c.label;
                                count: c.count;
                                selected: root.view == "cat:" + c.name;
                                clicked => {
                                    root.set-view(root.view == "cat:" + c.name ? "all" : "cat:" + c.name);
                                }
                                context(x, y) => {
                                    root.cat-target = c.name;
                                    root.cat-builtin = c.builtin;
                                    root.cat-x = self.absolute-position.x + x;
                                    root.cat-y = self.absolute-position.y + y;
                                    cat-menu.show();
                                }
                            }
                            Chip {
                                icon: "plus";
                                text: @tr("Category");
                                clicked => {
                                    root.add-category();
                                }
                            }
                        }
                    }
                }

                // ---- the downloads
                area := Rectangle {
                    vertical-stretch: 1;
                    property <length> gap: 14px;
                    property <int> per-row: max(1, floor((self.width + self.gap) / (300px + self.gap)));
                    property <length> card-w: (self.width - self.gap * (self.per-row - 1)) / self.per-row;
                    property <length> card-h: 158px * Theme.font-scale;
                    property <int> card-rows: ceil(root.active-rows.length / self.per-row);
                    // at most two rows of cards are shown at once; more scroll
                    property <length> cards-h: root.active-rows.length == 0 ? 0px : min(2, self.card-rows) * (self.card-h + self.gap) - self.gap;
                    VerticalLayout {
                        spacing: 14px;
                        padding-bottom: 96px;
                        if root.active-rows.length > 0: Flickable {
                            height: area.cards-h + 16px;
                            content-height: area.card-rows * (area.card-h + area.gap) - area.gap + 16px;
                            for r[i] in root.active-rows: DownloadCard {
                                x: (i - floor(i / area.per-row) * area.per-row) * (area.card-w + area.gap);
                                y: 6px + floor(i / area.per-row) * (area.card-h + area.gap);
                                width: area.card-w;
                                height: area.card-h;
                                data: r;
                                selected: r.sel;
                                queues: root.queues;
                                sel-count: root.sel-count;
                                pick(ctrl, shift) => {
                                    root.row-clicked(r.id, ctrl, shift);
                                    keys.focus();
                                }
                                right-pick => {
                                    root.row-right(r.id);
                                }
                                activated => {
                                    root.row-activated(r.id);
                                }
                                action(a) => {
                                    root.row-action(r.id, a);
                                }
                                move-to-queue(q) => {
                                    root.row-to-queue(r.id, q);
                                }
                            }
                        }
                        if root.done-rows.length > 0: HorizontalLayout {
                            height: 18px;
                            SectionTitle {
                                text: @tr("FINISHED") + "  ·  " + root.done-rows.length;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.sort-text(root.sort-by) + (root.sort-desc ? "  ↓" : "  ↑");
                                vertical-alignment: center;
                                font-size: 11px * Theme.font-scale;
                                color: Theme.muted;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.sort(root.sort-by);
                                    }
                                }
                            }
                        }
                        if root.done-rows.length > 0: ListView {
                            vertical-stretch: 1;
                            for r in root.done-rows: DoneRow {
                                data: r;
                                selected: r.sel;
                                queues: root.queues;
                                sel-count: root.sel-count;
                                pick(ctrl, shift) => {
                                    root.row-clicked(r.id, ctrl, shift);
                                    keys.focus();
                                }
                                right-pick => {
                                    root.row-right(r.id);
                                }
                                activated => {
                                    root.row-activated(r.id);
                                }
                                action(a) => {
                                    root.row-action(r.id, a);
                                }
                                move-to-queue(q) => {
                                    root.row-to-queue(r.id, q);
                                }
                                drag-out => {
                                    root.row-drag-out(r.id);
                                }
                            }
                        }
                        if root.done-rows.length == 0: Rectangle {
                            vertical-stretch: 1;
                        }
                    }
                    // nothing to show
                    if root.rows.length == 0: VerticalLayout {
                        y: 40px;
                        height: parent.height - 160px;
                        alignment: center;
                        spacing: 14px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 96px;
                                height: 96px;
                                border-radius: 48px;
                                background: Theme.glass;
                                border-width: 1px;
                                border-color: Theme.stroke;
                                Ico {
                                    kind: root.search != "" ? "search" : "download";
                                    width: 44px;
                                    height: 44px;
                                    tint: Theme.orange;
                                }
                            }
                        }
                        Text {
                            text: root.search != "" ? @tr("Nothing matches “{}”.", root.search) : @tr("No downloads here.\nClick “Add URL”, copy a link, or download something in your browser.");
                            horizontal-alignment: center;
                            font-size: 13px * Theme.font-scale;
                            color: Theme.text-2;
                        }
                    }
                }
            }
        }
    }

    // ---- the dock (floating, like NetNOC's)
    dock := Rectangle {
        x: 300px + 36px + (root.width - 300px - 36px - 18px - self.width) / 2;
        y: root.height - self.height - 18px;
        width: dock-row.preferred-width;
        height: 70px;
        border-radius: 35px;
        background: Theme.dark ? #23253ed9 : #f0f4fad9;
        border-width: 1px;
        border-color: Theme.stroke;
        drop-shadow-blur: 30px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 10px;
        dock-row := HorizontalLayout {
            padding: 12px;
            spacing: 10px;
            RoundBtn {
                icon: "add";
                accent: true;
                label: @tr("Add URL");
                clicked => {
                    root.add-url();
                }
            }
            RoundBtn {
                icon: "batch";
                label: @tr("Add Batch");
                clicked => {
                    root.add-batch();
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 30px;
                    background: Theme.rule;
                }
            }
            RoundBtn {
                icon: "play";
                label: @tr("Resume");
                enabled: root.can-resume;
                clicked => {
                    root.resume(root.selected-id);
                }
            }
            RoundBtn {
                icon: "pause";
                label: @tr("Stop");
                enabled: root.can-stop;
                clicked => {
                    root.pause(root.selected-id);
                }
            }
            RoundBtn {
                icon: "stopall";
                label: @tr("Stop All");
                clicked => {
                    root.stop-all();
                }
            }
            RoundBtn {
                icon: "delete";
                label: @tr("Delete");
                enabled: root.selected-id >= 0;
                clicked => {
                    root.delete(root.selected-id);
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 30px;
                    background: Theme.rule;
                }
            }
            RoundBtn {
                icon: "scheduler";
                label: @tr("Scheduler");
                clicked => {
                    root.open-scheduler();
                }
            }
            RoundBtn {
                icon: "limiter";
                label: @tr("Speed Limiter");
                active: root.limiter-on;
                clicked => {
                    root.open-limiter();
                }
            }
            RoundBtn {
                icon: "grabber";
                label: @tr("Grabber");
                clicked => {
                    root.grabber();
                }
            }
            RoundBtn {
                icon: "playlist";
                label: @tr("Playlist");
                clicked => {
                    root.playlist();
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 30px;
                    background: Theme.rule;
                }
            }
            RoundBtn {
                icon: "gear";
                label: @tr("Options");
                clicked => {
                    root.open-settings(0);
                }
            }
        }
    }
}

// ------------------------------------------------------------------ dialogs

// "Download File Info" – shown for every new download.
export component AddDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download File Info");
    preferred-width: 640px;
    min-width: 540px;

    in-out property <string> url;
    // full path: folder + file name
    in-out property <string> save-as;
    in-out property <string> description;
    in-out property <int> connections: 32;
    in-out property <int> category-index: 0;
    in-out property <bool> remember-path;
    in property <string> category-name: "General";
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> size-text;
    in property <string> info;
    in property <bool> probing;
    in property <bool> info-error;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in property <[string]> category-names: ["General", "Compressed", "Documents", "Music", "Programs", "Video", "Images"];
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    // a warning about the address (web page, duplicate...)
    in property <string> warning;
    // the server refused EdsDown: offer the browser instead
    in property <bool> can-use-browser;
    callback use-browser();

    callback check-url();
    callback category-changed(int);
    callback browse();
    callback start-now();
    callback later();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 14px;
            GridLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Row {
                    Text {
                        text: @tr("URL");
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.url;
                            placeholder-text: @tr("https://example.com/file");
                            horizontal-stretch: 1;
                            accepted(t) => {
                                root.check-url();
                            }
                        }
                        Button {
                            text: @tr("Check");
                            clicked => {
                                root.check-url();
                            }
                        }
                    }
                }
                Row {
                    Text {
                        text: @tr("Category");
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        ComboBox {
                            width: 200px;
                            model: root.category-names;
                            current-index <=> root.category-index;
                            selected(v) => {
                                root.category-changed(root.category-index);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
                Row {
                    Text {
                        text: @tr("Save As");
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.save-as;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "…";
                            clicked => {
                                root.browse();
                            }
                        }
                    }
                }
                Row {
                    Rectangle { }
                    CheckBox {
                        text: @tr("Remember this path for \"{}\" category", root.category-name);
                        checked <=> root.remember-path;
                    }
                }
                Row {
                    Text {
                        text: @tr("Description");
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    LineEdit {
                        text <=> root.description;
                        placeholder-text: @tr("optional note");
                    }
                }
            }
            VerticalLayout {
                width: 110px;
                spacing: 6px;
                alignment: start;
                padding-top: 4px;
                BigTypeIcon {
                    kind: root.kind;
                    ext: root.ext;
                }
                Text {
                    text: root.size-text;
                    horizontal-alignment: center;
                    font-size: 12px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: @tr("Use authorization");
                checked <=> root.use-login;
            }
            if root.use-login: Text {
                text: @tr("Login");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.user;
                horizontal-stretch: 1;
            }
            if root.use-login: Text {
                text: @tr("Password");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                horizontal-stretch: 1;
            }
            if !root.use-login: Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.warning != "": HorizontalLayout {
            spacing: 6px;
            Glyph {
                kind: "warn";
            }
            Text {
                text: root.warning;
                color: Theme.warn;
                wrap: word-wrap;
                font-size: 12px * Theme.font-scale;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 32px;
            border-width: 1px;
            border-color: root.info-error ? Theme.err : Theme.line;
            background: Theme.panel;
            border-radius: Theme.r-panel;
            Text {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                text: root.probing ? @tr("Checking the address…") : root.info;
                color: root.info-error ? Theme.err : Theme.muted;
                overflow: elide;
                font-size: 12px * Theme.font-scale;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Connections");
                vertical-alignment: center;
                color: Theme.text;
            }
            SpinBox {
                width: 110px;
                minimum: 1;
                maximum: 32;
                value <=> root.connections;
            }
            Rectangle {
                width: 10px;
            }
            Text {
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            ComboBox {
                model: root.queue-names;
                current-index <=> root.queue-index;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if root.can-use-browser: Button {
                text: @tr("Download with the browser");
                clicked => {
                    root.use-browser();
                }
            }
            if root.can-use-browser: Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Download Later");
                enabled: root.url != "";
                clicked => {
                    root.later();
                }
            }
            Button {
                text: @tr("Start Download");
                primary: true;
                enabled: root.url != "";
                clicked => {
                    root.start-now();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 30px;
    width: label.preferred-width + 28px;
    border-radius: 15px;
    background: root.active ? Theme.chip-on : ta.has-hover ? Theme.btn-hover : Theme.btn;
    border-width: 1px;
    border-color: root.active ? Theme.chip-on-line : Theme.stroke;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: 600;
        color: root.active ? Theme.chip-on-text : Theme.text;
    }
}

export component BatchDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add batch download");
    preferred-width: 640px;
    preferred-height: 520px;

    // 0: list of links, 1: address with a * pattern
    in-out property <int> mode: 0;
    in-out property <string> links;
    in-out property <string> folder;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in-out property <bool> start-now: true;
    in property <string> message;
    // pattern
    in-out property <string> pattern;
    in-out property <bool> letters;
    in-out property <string> from-text: "1";
    in-out property <string> to-text: "10";
    in-out property <int> wildcard-size: 1;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> preview;

    callback paste();
    callback browse();
    callback pattern-changed();
    callback ok();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 2px;
            TabButton {
                text: @tr("List of links");
                active: root.mode == 0;
                clicked => {
                    root.mode = 0;
                }
            }
            TabButton {
                text: @tr("Address with a pattern (*)");
                active: root.mode == 1;
                clicked => {
                    root.mode = 1;
                    root.pattern-changed();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.mode == 0: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                text: @tr("Paste the links, one per line. They download one after another in the queue you choose.");
                wrap: word-wrap;
                color: Theme.text;
            }
            TextEdit {
                text <=> root.links;
                vertical-stretch: 1;
                min-height: 200px;
                font-size: 12px * Theme.font-scale;
            }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: @tr("Paste from clipboard");
                    clicked => {
                        root.paste();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        if root.mode == 1: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                text: @tr("Type an address with a * where the number (or letter) goes, for example\nhttps://www.site.com/pictures/img*.jpg");
                wrap: word-wrap;
                color: Theme.text;
            }
            LineEdit {
                text <=> root.pattern;
                placeholder-text: @tr("https://www.site.com/pictures/img*.jpg");
                edited(t) => {
                    root.pattern-changed();
                }
            }
            HorizontalLayout {
                spacing: 16px;
                CheckBox {
                    text: @tr("Letters (a-z) instead of numbers");
                    checked <=> root.letters;
                    toggled => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("From");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.from-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    text: @tr("To");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.to-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    text: @tr("Wildcard size");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    maximum: 10;
                    value <=> root.wildcard-size;
                    edited(v) => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: @tr("Wildcard size 3 makes 001, 002 … 010.");
                color: Theme.muted;
                font-size: 11px * Theme.font-scale;
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Login");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.user;
                    placeholder-text: @tr("optional");
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("Password");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 80px;
                background: Theme.panel;
                border-radius: Theme.r-panel;
                border-width: 1px;
                border-color: Theme.line;
                Text {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    text: root.preview;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Row {
                Text {
                    text: @tr("Queue");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HorizontalLayout {
                    ComboBox {
                        model: root.queue-names;
                        current-index <=> root.queue-index;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }
            Row {
                Text {
                    text: @tr("Save all to");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        text <=> root.folder;
                        placeholder-text: @tr("automatic (by file type)");
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "…";
                        clicked => {
                            root.browse();
                        }
                    }
                }
            }
        }
        CheckBox {
            text: @tr("Start the queue now");
            checked <=> root.start-now;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Add");
                primary: true;
                clicked => {
                    root.ok();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// The per-download progress window (tabs like a classic download manager).
export component DetailsDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.percent + " " + root.name;
    preferred-width: 560px;
    min-width: 520px;

    in property <string> name;
    in property <string> percent;
    in property <string> url;
    in property <string> status;
    in property <string> size;
    in property <string> downloaded;
    in property <string> speed;
    in property <string> eta;
    in property <string> resumable;
    in property <bool> resumable-ok;
    in property <string> error;
    in property <string> kind: "general";
    in property <float> progress;
    in property <int> state;
    in property <[SegView]> segs;
    in-out property <bool> show-details: true;
    in-out property <int> tab: 0;
    // speed limiter tab
    in-out property <bool> limit-on;
    in-out property <int> limit-kb: 500;
    // options on completion tab
    in-out property <int> when-done: 0;
    in-out property <bool> complete-dialog: true;
    in-out property <bool> force-close;

    callback pause();
    callback resume();
    callback cancel-download();
    callback close-window();
    callback limit-changed();
    callback completion-changed();

    VerticalLayout {
        padding: 10px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 2px;
            TabButton {
                text: @tr("Download status");
                active: root.tab == 0;
                clicked => {
                    root.tab = 0;
                }
            }
            TabButton {
                text: @tr("Speed Limiter");
                active: root.tab == 1;
                clicked => {
                    root.tab = 1;
                }
            }
            TabButton {
                text: @tr("Options on completion");
                active: root.tab == 2;
                clicked => {
                    root.tab = 2;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            background: Theme.panel;
            border-radius: Theme.r-panel;
            border-width: 1px;
            border-color: Theme.line;
            min-height: 176px;
            if root.tab == 0: VerticalLayout {
                padding: 10px;
                spacing: 6px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    TypeIcon {
                        kind: root.kind;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        text: root.url;
                        font-size: 11px * Theme.font-scale;
                        overflow: elide;
                        color: Theme.accent;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.grid;
                }
                VerticalLayout {
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("Status");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            text: root.status;
                            color: root.state == 4 ? Theme.err : Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("File size");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            text: root.size;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("Downloaded");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            text: root.downloaded;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("Transfer rate");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            text: root.speed;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("Time left");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            text: root.eta;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("Resume capability");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            text: root.resumable;
                            color: root.resumable-ok ? Theme.ok : Theme.err;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
                if root.error != "": Text {
                    text: root.error;
                    color: Theme.err;
                    wrap: word-wrap;
                    font-size: 11px * Theme.font-scale;
                }
            }
            if root.tab == 1: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Transfer rate");
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.speed;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: @tr("Use speed limiter for this download");
                    checked <=> root.limit-on;
                    toggled => {
                        root.limit-changed();
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Maximum download speed (KB/s)");
                        color: root.limit-on ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 140px;
                        enabled: root.limit-on;
                        minimum: 1;
                        maximum: 1000000;
                        step-size: 50;
                        value <=> root.limit-kb;
                        edited(v) => {
                            root.limit-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    for kb in [128, 256, 512, 1024, 2048, 5120]: Button {
                        text: kb >= 1024 ? @tr("{} MB/s", kb / 1024) : @tr("{} KB/s", kb);
                        clicked => {
                            root.limit-on = true;
                            root.limit-kb = kb;
                            root.limit-changed();
                        }
                    }
                }
                Text {
                    text: @tr("Changes apply right away, even while downloading.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                }
            }
            if root.tab == 2: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                Text {
                    text: @tr("When this download completes:");
                    color: Theme.text;
                }
                ComboBox {
                    width: 300px;
                    model: [@tr("Do nothing (keep the computer on)"), @tr("Shut down the computer"), @tr("Sleep"), @tr("Exit EdsDown"), @tr("Hibernate")];
                    current-index <=> root.when-done;
                    selected(v) => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Force programs to close when shutting down");
                    checked <=> root.force-close;
                    enabled: root.when-done == 1;
                    toggled => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show the \"Download complete\" window");
                    checked <=> root.complete-dialog;
                    toggled => {
                        root.completion-changed();
                    }
                }
                Text {
                    text: @tr("You get 30 seconds to cancel before the computer shuts down, sleeps or hibernates.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        Bar {
            height: 12px;
            value: root.progress;
            tint: Theme.orange;
        }
        Rectangle {
            height: 8px;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: root.show-details ? @tr("<< Hide details") : @tr("Show details >>");
                clicked => {
                    root.show-details = !root.show-details;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.state == 0 || root.state == 1: Button {
                text: @tr("Pause");
                clicked => {
                    root.pause();
                }
            }
            if root.state == 2 || root.state == 4: Button {
                text: @tr("Resume");
                primary: true;
                clicked => {
                    root.resume();
                }
            }
            Button {
                text: root.state == 3 ? @tr("Close") : @tr("Cancel");
                clicked => {
                    if (root.state == 3) {
                        root.close-window();
                    } else {
                        root.cancel-download();
                    }
                }
            }
        }
        if root.show-details: VerticalLayout {
            spacing: 6px;
            padding-top: 8px;
            Text {
                text: @tr("Start positions and download progress by connections");
                font-size: 11px * Theme.font-scale;
                color: Theme.muted;
            }
            Rectangle {
                height: 16px;
                background: Theme.track;
                border-radius: 8px;
                clip: true;
                for s in root.segs: Rectangle {
                    x: parent.width * s.start;
                    y: 0;
                    width: parent.width * (s.done - s.start);
                    height: parent.height;
                    background: s.busy ? Theme.orange : Theme.blue;
                    animate width {
                        duration: 100ms;
                        easing: linear;
                    }
                }
                for s in root.segs: Rectangle {
                    x: parent.width * s.start;
                    y: 0;
                    width: 1.5px;
                    height: parent.height;
                    background: Theme.bg-a;
                }
            }
            Rectangle {
                height: 150px;
                background: Theme.panel;
                border-radius: Theme.r-panel;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 1px;
                    Rectangle {
                        height: 22px;
                        background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                        HorizontalLayout {
                            HeaderCell {
                                text: @tr("N.");
                                width: 34px;
                            }
                            HeaderCell {
                                text: @tr("Downloaded");
                                width: 110px;
                            }
                            HeaderCell {
                                text: @tr("Info");
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for s in root.segs: Rectangle {
                            height: 19px;
                            HorizontalLayout {
                                Cell {
                                    text: s.number;
                                    width: 34px;
                                    horizontal-alignment: center;
                                }
                                Cell {
                                    text: " " + s.downloaded;
                                    width: 110px;
                                    horizontal-alignment: left;
                                }
                                Cell {
                                    text: s.info;
                                    horizontal-stretch: 1;
                                    color: s.busy ? Theme.accent : Theme.muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component CompleteDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download complete");
    preferred-width: 540px;

    in property <string> name;
    in property <string> size;
    in property <string> path;
    in property <string> url;
    in property <string> kind: "general";
    in property <string> ext;
    in-out property <bool> dont-show;

    callback open-file();
    callback open-with();
    callback open-folder();
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 16px;
            BigTypeIcon {
                kind: root.kind;
                ext: root.ext;
            }
            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Download complete");
                    font-size: 15px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.ok;
                }
                GridLayout {
                    spacing: 6px;
                    Row {
                        Text {
                            text: @tr("Address");
                            color: Theme.muted;
                        }
                        Text {
                            text: root.url;
                            overflow: elide;
                            font-size: 11px * Theme.font-scale;
                            color: Theme.accent;
                        }
                    }
                    Row {
                        Text {
                            text: @tr("File size");
                            color: Theme.muted;
                        }
                        Text {
                            text: root.size;
                            color: Theme.text;
                        }
                    }
                    Row {
                        Text {
                            text: @tr("Saved as");
                            color: Theme.muted;
                        }
                        Text {
                            text: root.path;
                            wrap: word-wrap;
                            font-size: 11px * Theme.font-scale;
                            color: Theme.text;
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: @tr("Don't show this again");
                checked <=> root.dont-show;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Open");
                primary: true;
                clicked => {
                    root.open-file();
                }
            }
            Button {
                text: @tr("Open with…");
                clicked => {
                    root.open-with();
                }
            }
            Button {
                text: @tr("Open folder");
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
