// EdsDown – user interface (Slint): a side bar (views, categories, queues,
// total speed), a toolbar, the downloads as one sortable list with the
// progress in each row, and a status bar. One flat dark theme.
// Arabic reads from right to left (Theme.rtl).

import { LineEdit, SpinBox, ComboBox, ListView, TabWidget, TextEdit, Palette } from "std-widgets.slint";
import { ToolTip, DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme, ThemedWindow, CaptionButton, HRow, P, Icon, G, TypeIcon, BigTypeIcon, ToolBtn, ToolSeparator, TreeItem, HeaderCell, Cell, MenuEntry, MenuSep, MenuLabel, Glyph, Button, CheckBox, MenuFrame, Ico, Kinds, KindBadge, RoundBtn, Pill, Chip, Glass, SectionTitle, Bar } from "common.slint";
export { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme }
export { BrowserRow } from "dialogs.slint";
export { ConfirmDialog, ColumnsDialog, CategoryDialog, FindDialog, PropertiesDialog, DuplicateDialog, CountdownDialog, SchedulerDialog, GrabberDialog, TipDialog, RefreshDialog, SettingsDialog, PlaylistDialog, TorrentDialog, BrowserDialog, AboutDialog, UpdateDialog, WhatsNewDialog } from "dialogs.slint";

// ------------------------------------------------------------------ download menu

// Right click on a card or a row.
component RowMenu inherits PopupWindow {
    in property <DownloadRow> data;
    in property <[QueueRow]> queues;
    in property <int> sel-count;
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    property <bool> done: root.data.state == 3;
    property <bool> can-resume: root.data.state == 2 || root.data.state == 4;
    property <bool> can-stop: root.data.state == 0 || root.data.state == 1;
    width: 270px;
    height: list.preferred-height + 2px;
    MenuFrame {
        width: parent.width;
        height: parent.height;
        list := VerticalLayout {
            padding: 6px;
            if root.sel-count > 1: MenuLabel {
                text: @tr("{} downloads selected", root.sel-count);
            }
            MenuEntry {
                text: root.done ? @tr("Open") : @tr("Show download progress");
                glyph: root.done ? "openwith" : "progress";
                bold: true;
                clicked => {
                    root.activated();
                }
            }
            MenuEntry {
                text: @tr("Open with…");
                glyph: "openwith";
                enabled: root.done;
                clicked => {
                    root.action("openwith");
                }
            }
            MenuEntry {
                text: @tr("Open folder");
                glyph: "folder";
                clicked => {
                    root.action("folder");
                }
            }
            if !root.done && (root.data.kind == "video" || root.data.kind == "audio"): MenuEntry {
                text: @tr("Play while downloading");
                glyph: "play";
                glyph-color: Theme.primary;
                clicked => {
                    root.action("preview");
                }
            }
            MenuSep { }
            MenuEntry {
                text: @tr("Resume download");
                glyph: "play";
                glyph-color: Theme.green;
                enabled: root.can-resume || root.sel-count > 1;
                clicked => {
                    root.action("resume");
                }
            }
            MenuEntry {
                text: @tr("Stop download");
                glyph: "pause";
                glyph-color: Theme.orange;
                enabled: root.can-stop || root.sel-count > 1;
                clicked => {
                    root.action("stop");
                }
            }
            MenuEntry {
                text: @tr("Redownload");
                glyph: "redo";
                clicked => {
                    root.action("restart");
                }
            }
            MenuEntry {
                text: @tr("Refresh download address…");
                glyph: "refresh";
                enabled: !root.done;
                clicked => {
                    root.action("refresh");
                }
            }
            MenuEntry {
                text: @tr("Move / Rename…");
                glyph: "edit";
                clicked => {
                    root.action("move");
                }
            }
            MenuSep { }
            MenuLabel {
                text: @tr("Move to queue");
            }
            for q in root.queues: MenuEntry {
                text: q.name;
                glyph: "queue";
                checked: root.data.queue == q.id;
                clicked => {
                    root.move-to-queue(q.id);
                }
            }
            MenuEntry {
                text: @tr("Delete from queue");
                glyph: "minus";
                enabled: root.data.queue != "";
                clicked => {
                    root.move-to-queue(-1);
                }
            }
            MenuSep { }
            MenuEntry {
                text: @tr("Copy address");
                glyph: "copy";
                clicked => {
                    root.action("copy");
                }
            }
            MenuEntry {
                text: @tr("Check file (SHA-256)");
                glyph: "hash";
                enabled: root.done;
                clicked => {
                    root.action("sha256");
                }
            }
            MenuEntry {
                text: @tr("Properties");
                glyph: "info";
                clicked => {
                    root.action("properties");
                }
            }
            MenuSep { }
            MenuEntry {
                text: @tr("Remove");
                glyph: "delete";
                glyph-color: Theme.red;
                clicked => {
                    root.action("delete");
                }
            }
        }
    }
}

// ------------------------------------------------------------------ list and side bar parts

// An entry of the side bar (views, categories): icon, name, count.
component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> count;
    in property <bool> selected;
    // tint the icon with its file type color (categories)
    in property <bool> kind-tint;
    callback clicked();
    // right click at (x, y) inside the entry
    callback context(length, length);
    height: max(34px, 30px * Theme.font-scale);
    border-radius: Theme.r-ctl;
    background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.context(self.mouse-x, self.mouse-y);
            }
        }
    }
    // the chosen one: a short accent bar at the edge
    if root.selected: Rectangle {
        x: Theme.rtl ? parent.width - 3px : 0;
        y: (parent.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.primary;
    }
    HRow {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 17px;
            Ico {
                y: (parent.height - 17px) / 2;
                kind: root.icon;
                width: 17px;
                height: 17px;
                tint: root.selected ? Theme.primary : root.kind-tint ? Kinds.tint(root.icon) : Theme.muted;
            }
        }
        Text {
            text: root.text;
            min-width: 0px;
            horizontal-stretch: 1;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            vertical-alignment: center;
            font-size: 13px * Theme.font-scale;
            font-weight: root.selected ? 600 : 500;
            color: root.selected ? Theme.text : Theme.text-2;
            overflow: elide;
        }
        if root.count != "" && root.count != "0": Text {
            text: root.count;
            vertical-alignment: center;
            font-size: 11.5px * Theme.font-scale;
            font-weight: 600;
            color: root.selected ? Theme.primary : Theme.muted;
        }
    }
}

// A queue in the side bar: name, count, start / stop.
component QueueItem inherits Rectangle {
    in property <QueueRow> q;
    in property <bool> selected;
    callback clicked();
    callback toggle();
    callback edit();
    callback context(length, length);
    height: max(34px, 30px * Theme.font-scale);
    border-radius: Theme.r-ctl;
    background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.edit();
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.context(self.mouse-x, self.mouse-y);
            }
        }
    }
    HRow {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 10px;
        Rectangle {
            width: 17px;
            Ico {
                y: (parent.height - 17px) / 2;
                kind: "queue";
                width: 17px;
                height: 17px;
                tint: root.q.running ? Theme.green : Theme.muted;
            }
        }
        Text {
            text: root.q.name;
            min-width: 0px;
            horizontal-stretch: 1;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            vertical-alignment: center;
            font-size: 13px * Theme.font-scale;
            font-weight: 500;
            color: Theme.text-2;
            overflow: elide;
        }
        if root.q.count > 0: Text {
            text: root.q.count;
            vertical-alignment: center;
            font-size: 11.5px * Theme.font-scale;
            font-weight: 600;
            color: Theme.muted;
        }
        VerticalLayout {
            alignment: center;
            RoundBtn {
                size: 26px;
                icon: root.q.running ? "stop" : "play";
                active: root.q.running;
                label: root.q.running ? @tr("Stop queue") : @tr("Start queue");
                clicked => {
                    root.toggle();
                }
            }
        }
    }
}

// A button of the toolbar: icon and a short name.
component TbBtn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <color> tint: Theme.btn-ico;
    // narrow window: the icon only (the name shows on the mouse)
    in property <bool> compact;
    callback clicked();
    height: 34px;
    width: root.compact ? 36px : row.preferred-width;
    border-radius: Theme.r-ctl;
    background: root.active ? Theme.select : ta.pressed && root.enabled ? Theme.btn-press : ta.has-hover && root.enabled ? Theme.btn-hover : transparent;
    animate background { duration: 100ms; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    row := HRow {
        padding-left: root.compact ? 9.5px : 10px;
        padding-right: root.compact ? 9.5px : 12px;
        spacing: 7px;
        opacity: root.enabled ? 1.0 : 0.38;
        Rectangle {
            width: 17px;
            Ico {
                y: (parent.height - 17px) / 2;
                kind: root.icon;
                width: 17px;
                height: 17px;
                tint: root.active ? Theme.primary : root.tint;
            }
        }
        if !root.compact: Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 12.5px * Theme.font-scale;
            font-weight: 500;
            color: Theme.text;
        }
    }
    if root.compact && ta.has-hover: Rectangle {
        y: root.height + 6px;
        x: (root.width - self.width) / 2;
        width: tip.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: Theme.tooltip;
        border-width: 1px;
        border-color: Theme.stroke;
        tip := Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: Theme.tooltip-text;
        }
    }
}

// A thin vertical line between groups of the toolbar.
component TbSep inherits Rectangle {
    width: 1px;
    height: 20px;
    background: Theme.stroke;
}

// A column title of the list (click: sort by it).
component ColHead inherits Rectangle {
    in property <string> text;
    in property <string> key;
    in property <string> sort-by;
    in property <bool> sort-desc;
    in property <bool> right;
    callback sort(string);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.sort(root.key);
        }
    }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text + (root.sort-by == root.key ? (root.sort-desc ? "  ↓" : "  ↑") : "");
        horizontal-alignment: root.right != Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        font-size: 11px * Theme.font-scale;
        font-weight: 600;
        letter-spacing: 0.3px;
        color: root.sort-by == root.key ? Theme.text : (ta.has-hover ? Theme.text-2 : Theme.muted);
        overflow: elide;
    }
}

// One download in the list: type, name and state, size, progress, speed,
// time left and date. Right click: its menu; a finished one can be dragged
// out of the program (sideways).
component ListRow inherits Rectangle {
    in property <DownloadRow> data;
    in property <bool> selected;
    in property <[QueueRow]> queues;
    in property <int> sel-count;
    in property <Cols> cols;
    in property <length> w-size;
    in property <length> w-progress;
    in property <length> w-speed;
    in property <length> w-eta;
    in property <length> w-date;
    callback pick(bool, bool);
    callback right-pick();
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    callback drag-out();
    property <bool> running: root.data.state == 1;
    property <bool> queued: root.data.state == 0;
    property <bool> done: root.data.state == 3;
    property <bool> failed: root.data.state == 4;
    property <color> state-color: root.done ? Theme.green : root.failed ? Theme.red : root.running ? Theme.primary : root.queued ? Theme.purple : Theme.muted;
    property <bool> dragged-out;
    property <length> menu-x;
    property <length> menu-y;
    height: max(52px, 46px * Theme.font-scale);
    background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        double-clicked => {
            root.activated();
        }
        moved => {
            // only a clearly sideways pull: moving up or down selects rows instead
            if (root.done && self.pressed && !root.dragged-out && abs(self.mouse-x - self.pressed-x) > 24px && abs(self.mouse-x - self.pressed-x) > 2 * abs(self.mouse-y - self.pressed-y)) {
                root.dragged-out = true;
                root.drag-out();
            }
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.dragged-out = false;
                root.pick(ev.modifiers.control, ev.modifiers.shift);
            }
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.right-pick();
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
    }
    // the selected row: an accent bar at its edge
    if root.selected: Rectangle {
        x: Theme.rtl ? parent.width - 2px : 0;
        width: 2px;
        height: parent.height;
        background: Theme.primary;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.rule;
    }
    HRow {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            KindBadge {
                kind: root.data.kind;
                width: 30px;
                height: 30px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 120px;
            Text {
                text: root.data.name;
                min-width: 0px;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                font-size: 13px * Theme.font-scale;
                font-weight: 500;
                color: Theme.text;
                overflow: elide;
            }
            HRow {
                spacing: 6px;
                Rectangle {
                    width: 6px;
                    Rectangle {
                        y: (parent.height - 6px) / 2;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.state-color;
                    }
                }
                Text {
                    text: root.done && root.data.save-to != "" ? root.data.save-to
                        : root.running && root.data.speed != "" ? (root.data.eta != "" ? @tr("Downloading · {} left", root.data.eta) : @tr("Downloading"))
                        : root.data.state == 2 ? @tr("Paused")
                        : root.data.status;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    font-size: 11.5px * Theme.font-scale;
                    color: root.failed ? Theme.red : Theme.muted;
                    overflow: elide;
                }
            }
        }
        if root.cols.size: Text {
            width: root.w-size;
            text: root.data.size;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            vertical-alignment: center;
            font-size: 12px * Theme.font-scale;
            color: Theme.text-2;
            overflow: elide;
        }
        VerticalLayout {
            width: root.w-progress;
            alignment: center;
            spacing: 5px;
            HRow {
                Text {
                    text: root.done ? @tr("Complete") : root.data.progress > 0 ? round(root.data.progress * 1000) / 10 + "%" : "—";
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    font-size: 11.5px * Theme.font-scale;
                    font-weight: 600;
                    color: root.done ? Theme.green : root.failed ? Theme.red : Theme.text;
                }
            }
            Bar {
                height: 4px;
                value: root.done ? 1 : root.data.progress;
                tint: root.state-color;
            }
        }
        if root.cols.speed: Text {
            width: root.w-speed;
            text: root.data.speed;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            vertical-alignment: center;
            font-size: 12px * Theme.font-scale;
            font-weight: 500;
            color: Theme.text;
            overflow: elide;
        }
        if root.cols.eta: Text {
            width: root.w-eta;
            text: root.data.eta;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            vertical-alignment: center;
            font-size: 12px * Theme.font-scale;
            color: Theme.text-2;
            overflow: elide;
        }
        if root.cols.last: Text {
            width: root.w-date;
            text: root.data.last-try;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            vertical-alignment: center;
            font-size: 11.5px * Theme.font-scale;
            color: Theme.muted;
            overflow: elide;
        }
        // quick action: pause / resume, or open the folder when finished
        VerticalLayout {
            alignment: center;
            RoundBtn {
                size: 30px;
                icon: root.done ? "folder" : root.running || root.queued ? "pause" : "play";
                label: root.done ? @tr("Open folder") : root.running || root.queued ? @tr("Stop download") : @tr("Resume download");
                clicked => {
                    root.action(root.done ? "folder" : root.running || root.queued ? "stop" : "resume");
                }
            }
        }
    }
    menu := RowMenu {
        x: root.menu-x;
        y: root.menu-y;
        data: root.data;
        queues: root.queues;
        sel-count: root.sel-count;
        activated => {
            root.activated();
        }
        action(a) => {
            root.action(a);
        }
        move-to-queue(q) => {
            root.move-to-queue(q);
        }
    }
}

// An entry of the "⋯" menu that opens another page of it.
component PageEntry inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <string> value;
    callback clicked();
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.btn-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Glyph {
            y: (parent.height - 16px) / 2;
            kind: root.glyph;
            tint: Theme.btn-ico;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 12px * Theme.font-scale;
            color: Theme.text;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.value != "": Text {
            text: root.value;
            vertical-alignment: center;
            horizontal-alignment: right;
            max-width: 110px;
            font-size: 11px * Theme.font-scale;
            color: Theme.muted;
            overflow: elide;
        }
        Glyph {
            y: (parent.height - 16px) / 2;
            kind: "chevron-right";
            tint: Theme.muted;
        }
    }
}

// The EdsDown mark: an arrow into a tray on the accent tile.
component LogoMark inherits Rectangle {
    width: 30px;
    height: 30px;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("logo-mark.png");
        image-fit: contain;
    }
}

// ------------------------------------------------------------------ main window

export component MainWindow inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("EdsDown");
    // Options > Appearance > Background picture (instead of the waves)
    in property <image> bg-image;
    in property <bool> has-bg-image;
    preferred-width: 1180px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 580px;

    in property <[DownloadRow]> rows;
    // the same rows, split: not finished (cards) and finished (compact rows)
    in property <[DownloadRow]> active-rows;
    in property <[DownloadRow]> done-rows;
    // the side column: running downloads (a few), total speed, the day
    in property <[DownloadRow]> side-rows;
    in property <string> speed-value: "0";
    in property <string> speed-unit: "KB/s";
    in property <string> speed-caption;
    // the speed of the last minute, as path commands on a 100×40 grid
    in property <string> spark-line: "M 0 40 L 100 40";
    in property <string> spark-area: "M 0 40 L 100 40 Z";
    in property <string> today-count: "0";
    in property <string> today-bytes: "0 B";
    in property <string> date-text;
    in property <int> running-count;
    // the browser add-in talked to the program in the last minutes
    in property <bool> browser-on;
    in property <[QueueRow]> queues;
    in property <[CatRow]> categories;
    // counts: all, unfinished, finished
    in property <string> count-all;
    in property <string> count-unfinished;
    in property <string> count-finished;
    in-out property <int> selected-id: -1;
    // "all", "cat:Video", "unfinished", "unf:Video", "finished", "fin:Video", "queue:3"
    in-out property <string> view: "all";
    in-out property <string> search;
    in property <string> status-text;
    in property <string> limiter-text;
    in property <int> selected-state: -1;
    // multiple selection: how many, and whether any can be resumed / stopped
    in property <int> sel-count;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <int> current-queue: 1;
    in property <bool> limiter-on;
    in property <bool> hide-categories;
    in property <string> sort-by: "date";
    in property <bool> sort-desc: true;
    // when all downloads finish: 0 nothing, 1 shut down, 2 sleep, 3 exit, 4 hibernate
    in property <int> all-done: 0;
    in property <Cols> cols: { q: true, size: true, status: true, eta: true, speed: true, last: true, desc: true };
    in property <bool> toolbar-small;
    in property <string> language: "en";
    in-out property <bool> open-all: true;
    in-out property <bool> open-unf: false;
    in-out property <bool> open-fin: false;
    in-out property <bool> open-queues: true;
    in property <[ColDef]> columns;

    callback add-url();
    callback add-batch();
    callback add-batch-clipboard();
    callback resume(int);
    callback pause(int);
    callback resume-all();
    callback stop-all();
    callback delete(int);
    callback delete-completed();
    callback open-settings(int);
    callback open-scheduler();
    callback open-limiter();
    callback toggle-limiter();
    callback start-queue(int);
    callback stop-queue(int);
    callback new-queue();
    callback edit-queue(int);
    callback delete-queue(int);
    callback view-changed(string);
    callback search-changed();
    callback sort(string);
    callback row-activated(int);
    callback row-clicked(int, bool, bool);
    callback row-right(int);
    callback row-drag(int, int);
    callback row-drag-out(int);
    callback column-resized(int, length);
    callback column-dropped(int, length);
    callback columns-changed();
    callback select-all();
    callback row-action(int, string);
    callback row-to-queue(int, int);
    callback open-download-folder();
    callback export-list(string);
    callback import-list(string);
    callback set-theme(int);
    callback set-language(string);
    callback toggle-categories();
    callback set-toolbar-small(bool);
    callback open-columns();
    callback update-tools();
    callback check-app-update();
    callback set-all-done(int);
    callback add-category();
    callback category-props(string);
    callback delete-category(string);
    callback find();
    callback find-next();
    callback grabber();
    callback playlist();
    callback torrent();
    callback browsers();
    callback tips();
    callback about();
    callback quit();

    // the window's width, for the toolbar (kept apart from the layout:
    // labels on / off must not change the width they depend on)
    property <length> win-w: 1600px;
    changed width => {
        root.win-w = self.width;
    }
    init => {
        root.win-w = self.width;
    }
    function set-view(v: string) {
        root.view = v;
        root.view-changed(v);
    }
    pure function done-text(n: int) -> string {
        if (n == 1) { return @tr("Shut down"); }
        if (n == 2) { return @tr("Sleep"); }
        if (n == 3) { return @tr("Exit EdsDown"); }
        if (n == 4) { return @tr("Hibernate"); }
        return @tr("Do nothing");
    }
    pure function sort-text(k: string) -> string {
        if (k == "added") { return @tr("By order of addition"); }
        if (k == "name") { return @tr("File name"); }
        if (k == "size") { return @tr("Size"); }
        if (k == "status") { return @tr("Status"); }
        if (k == "eta") { return @tr("Time left"); }
        if (k == "speed") { return @tr("Transfer rate"); }
        return @tr("Last try date");
    }

    // ---- popups
    property <string> page: "main";
    more-menu := PopupWindow {
        x: Theme.rtl ? 14px : root.width - self.width - 14px;
        y: 52px;
        width: 340px;
        height: min(more-list.preferred-height + 2px, root.height - 90px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        MenuFrame {
            width: parent.width;
            height: parent.height;
            clip: true;
            Flickable {
                content-height: more-list.preferred-height;
                more-list := VerticalLayout {
                    padding: 6px;
                    if root.page == "main": VerticalLayout {
                        MenuEntry {
                            text: @tr("Resume all");
                            glyph: "play";
                            glyph-color: Theme.green;
                            clicked => {
                                root.resume-all();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Stop all");
                            glyph: "stopall";
                            glyph-color: Theme.orange;
                            clicked => {
                                root.stop-all();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Delete all completed");
                            glyph: "deletedone";
                            glyph-color: Theme.red;
                            clicked => {
                                root.delete-completed();
                                more-menu.close();
                            }
                        }
                        MenuSep { }
                        MenuEntry {
                            text: @tr("Add a torrent / magnet link…");
                            glyph: "torrent";
                            glyph-color: Theme.green;
                            clicked => {
                                root.torrent();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Add batch download from clipboard");
                            glyph: "copy";
                            clicked => {
                                root.add-batch-clipboard();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Find…   Ctrl+F");
                            glyph: "search";
                            clicked => {
                                root.find();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Open download folder");
                            glyph: "folder";
                            clicked => {
                                root.open-download-folder();
                                more-menu.close();
                            }
                        }
                        PageEntry {
                            text: @tr("Export / Import");
                            glyph: "export";
                            clicked => {
                                root.page = "io";
                            }
                        }
                        MenuSep { }
                        PageEntry {
                            text: @tr("When all downloads finish");
                            glyph: "power";
                            value: root.done-text(root.all-done);
                            clicked => {
                                root.page = "done";
                            }
                        }
                        PageEntry {
                            text: @tr("Arrange files");
                            glyph: "sort";
                            value: root.sort-text(root.sort-by);
                            clicked => {
                                root.page = "sort";
                            }
                        }
                        PageEntry {
                            text: @tr("Language");
                            glyph: "language";
                            clicked => {
                                root.page = "lang";
                            }
                        }
                        MenuEntry {
                            text: @tr("Appearance…");
                            glyph: "sun";
                            clicked => {
                                root.open-settings(9);
                                more-menu.close();
                            }
                        }
                        MenuSep { }
                        MenuEntry {
                            text: @tr("Add EdsDown to my browser…");
                            glyph: "browser";
                            clicked => {
                                root.browsers();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Tip of the day…");
                            glyph: "bulb";
                            clicked => {
                                root.tips();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Check for updates");
                            glyph: "refresh";
                            clicked => {
                                root.check-app-update();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("Check for updates (video downloader)");
                            glyph: "video";
                            clicked => {
                                root.update-tools();
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("About EdsDown");
                            glyph: "info";
                            clicked => {
                                root.about();
                                more-menu.close();
                            }
                        }
                        MenuSep { }
                        MenuEntry {
                            text: @tr("Exit");
                            glyph: "exit";
                            glyph-color: Theme.red;
                            clicked => {
                                root.quit();
                                more-menu.close();
                            }
                        }
                    }
                    if root.page != "main": MenuEntry {
                        text: @tr("Back");
                        glyph: "chevron-down";
                        bold: true;
                        clicked => {
                            root.page = "main";
                        }
                    }
                    if root.page != "main": MenuSep { }
                    if root.page == "io": VerticalLayout {
                        MenuLabel {
                            text: @tr("Export");
                        }
                        MenuEntry {
                            text: @tr("To download list file (.ef2)…");
                            glyph: "export";
                            clicked => {
                                root.export-list("ef2");
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("To text file…");
                            glyph: "text";
                            clicked => {
                                root.export-list("txt");
                                more-menu.close();
                            }
                        }
                        MenuLabel {
                            text: @tr("Import");
                        }
                        MenuEntry {
                            text: @tr("From download list file (.ef2)…");
                            glyph: "import";
                            clicked => {
                                root.import-list("ef2");
                                more-menu.close();
                            }
                        }
                        MenuEntry {
                            text: @tr("From text file…");
                            glyph: "text";
                            clicked => {
                                root.import-list("txt");
                                more-menu.close();
                            }
                        }
                    }
                    if root.page == "done": VerticalLayout {
                        for o in [0, 1, 2, 4, 3]: MenuEntry {
                            text: root.done-text(o);
                            glyph: o == 0 ? "close" : o == 3 ? "exit" : "power";
                            checked: root.all-done == o;
                            clicked => {
                                root.set-all-done(o);
                                more-menu.close();
                            }
                        }
                    }
                    if root.page == "sort": VerticalLayout {
                        for k in ["added", "name", "size", "status", "eta", "speed", "date"]: MenuEntry {
                            text: root.sort-text(k);
                            glyph: "sort";
                            checked: root.sort-by == k;
                            clicked => {
                                root.sort(k);
                                more-menu.close();
                            }
                        }
                    }
                    if root.page == "lang": VerticalLayout {
                        for l in [
                            { code: "en", name: "English" },
                            { code: "pt", name: "Português" },
                            { code: "es", name: "Español" },
                            { code: "fr", name: "Français" },
                            { code: "de", name: "Deutsch" },
                            { code: "tr", name: "Türkçe" },
                            { code: "ru", name: "Русский" },
                            { code: "ar", name: "العربية" }
                        ]: MenuEntry {
                            text: l.name;
                            glyph: "language";
                            checked: root.language == l.code;
                            clicked => {
                                root.set-language(l.code);
                                more-menu.close();
                            }
                        }
                    }
                }
            }
        }
    }

    // right click on a category chip
    property <string> cat-target;
    property <bool> cat-builtin;
    property <length> cat-x;
    property <length> cat-y;
    cat-menu := PopupWindow {
        x: root.cat-x;
        y: root.cat-y;
        width: 230px;
        height: cat-list.preferred-height + 2px;
        MenuFrame {
            width: parent.width;
            height: parent.height;
            cat-list := VerticalLayout {
                padding: 6px;
                MenuEntry {
                    text: @tr("Properties");
                    glyph: "edit";
                    enabled: root.cat-target != "";
                    clicked => {
                        root.category-props(root.cat-target);
                    }
                }
                MenuEntry {
                    text: @tr("Delete");
                    glyph: "delete";
                    glyph-color: Theme.red;
                    enabled: root.cat-target != "" && !root.cat-builtin;
                    clicked => {
                        root.delete-category(root.cat-target);
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("New category…");
                    glyph: "plus";
                    clicked => {
                        root.add-category();
                    }
                }
            }
        }
    }

    // right click on a queue
    property <int> q-target;
    property <length> q-x;
    property <length> q-y;
    q-menu := PopupWindow {
        x: root.q-x;
        y: root.q-y;
        width: 230px;
        height: q-list.preferred-height + 2px;
        MenuFrame {
            width: parent.width;
            height: parent.height;
            q-list := VerticalLayout {
                padding: 6px;
                MenuEntry {
                    text: @tr("Start queue");
                    glyph: "play";
                    glyph-color: Theme.green;
                    clicked => {
                        root.start-queue(root.q-target);
                    }
                }
                MenuEntry {
                    text: @tr("Stop queue");
                    glyph: "stop";
                    glyph-color: Theme.orange;
                    clicked => {
                        root.stop-queue(root.q-target);
                    }
                }
                MenuEntry {
                    text: @tr("Edit");
                    glyph: "edit";
                    clicked => {
                        root.edit-queue(root.q-target);
                    }
                }
                MenuEntry {
                    text: @tr("Delete");
                    glyph: "delete";
                    glyph-color: Theme.red;
                    enabled: root.q-target != 1;
                    clicked => {
                        root.delete-queue(root.q-target);
                    }
                }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "a" || event.text == "A" || event.text == "ش")) {
                root.select-all();
                return accept;
            }
            if (event.text == Key.Delete && root.selected-id >= 0) {
                root.delete(root.selected-id);
                return accept;
            }
            if (event.text == Key.Return && root.selected-id >= 0) {
                root.row-activated(root.selected-id);
                return accept;
            }
            if (event.text == Key.F3) {
                root.find-next();
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F" || event.text == "ب")) {
                root.find();
                return accept;
            }
            if (event.modifiers.control && (event.text == "n" || event.text == "N" || event.text == "ى")) {
                root.add-url();
                return accept;
            }
            if (event.modifiers.control && (event.text == "b" || event.text == "B" || event.text == "لا" || event.text == "ﻻ")) {
                root.add-batch();
                return accept;
            }
            reject
        }

        HRow {
            spacing: 0px;

            // ================================================ side bar
            Rectangle {
                width: 236px;
                // always as tall as the window (its list scrolls)
                max-height: 100000px;
                background: Theme.side;
                Rectangle {
                    x: Theme.rtl ? 0 : parent.width - 1px;
                    width: 1px;
                    background: Theme.stroke;
                }
                VerticalLayout {
                    padding: 14px;
                    padding-top: 16px;
                    spacing: 12px;
                    // brand
                    HRow {
                        height: 34px;
                        spacing: 10px;
                        padding-left: 4px;
                        VerticalLayout {
                            alignment: center;
                            LogoMark { }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "EdsDown";
                                font-size: 16px * Theme.font-scale;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: @tr("Download manager");
                                font-size: 11px * Theme.font-scale;
                                color: Theme.muted;
                            }
                        }
                    }
                    // the main action
                    Rectangle {
                        height: 38px;
                        border-radius: Theme.r-ctl;
                        background: add-ta.pressed ? Theme.primary-press : add-ta.has-hover ? Theme.primary-hover : Theme.primary;
                        animate background { duration: 100ms; }
                        add-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.add-url();
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Ico {
                                y: (parent.height - 18px) / 2;
                                kind: "add";
                                width: 18px;
                                height: 18px;
                                tint: Theme.on-primary;
                                weight: 2.2;
                            }
                            Text {
                                text: @tr("New download");
                                vertical-alignment: center;
                                font-size: 13px * Theme.font-scale;
                                font-weight: 600;
                                color: Theme.on-primary;
                            }
                        }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        max-height: 100000px;
                        content-height: nav.preferred-height;
                        nav := VerticalLayout {
                            spacing: 2px;
                            NavItem {
                                icon: "download";
                                text: @tr("All");
                                count: root.count-all;
                                selected: root.view == "all";
                                clicked => {
                                    root.set-view("all");
                                }
                            }
                            NavItem {
                                icon: "progress";
                                text: @tr("In progress");
                                count: root.count-unfinished;
                                selected: root.view == "unfinished";
                                clicked => {
                                    root.set-view("unfinished");
                                }
                            }
                            NavItem {
                                icon: "check";
                                text: @tr("Finished");
                                count: root.count-finished;
                                selected: root.view == "finished";
                                clicked => {
                                    root.set-view("finished");
                                }
                            }
                            // categories
                            HRow {
                                height: 30px;
                                padding-left: 12px;
                                padding-top: 10px;
                                SectionTitle {
                                    text: @tr("CATEGORIES");
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                RoundBtn {
                                    size: 22px;
                                    icon: "plus";
                                    label: @tr("New category…");
                                    clicked => {
                                        root.add-category();
                                    }
                                }
                            }
                            for c in root.categories: NavItem {
                                icon: c.kind;
                                kind-tint: true;
                                text: c.label;
                                count: c.count;
                                selected: root.view == "cat:" + c.name;
                                clicked => {
                                    root.set-view(root.view == "cat:" + c.name ? "all" : "cat:" + c.name);
                                }
                                context(x, y) => {
                                    root.cat-target = c.name;
                                    root.cat-builtin = c.builtin;
                                    root.cat-x = self.absolute-position.x + x;
                                    root.cat-y = self.absolute-position.y + y;
                                    cat-menu.show();
                                }
                            }
                            // queues
                            HRow {
                                height: 30px;
                                padding-left: 12px;
                                padding-top: 10px;
                                SectionTitle {
                                    text: @tr("QUEUES");
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                RoundBtn {
                                    size: 22px;
                                    icon: "plus";
                                    label: @tr("New queue");
                                    clicked => {
                                        root.new-queue();
                                    }
                                }
                            }
                            for q in root.queues: QueueItem {
                                q: q;
                                selected: root.view == "queue:" + q.id;
                                clicked => {
                                    root.set-view(root.view == "queue:" + q.id ? "all" : "queue:" + q.id);
                                }
                                edit => {
                                    root.edit-queue(q.id);
                                }
                                toggle => {
                                    if (q.running) {
                                        root.stop-queue(q.id);
                                    } else {
                                        root.start-queue(q.id);
                                    }
                                }
                                context(x, y) => {
                                    root.q-target = q.id;
                                    root.q-x = self.absolute-position.x + x;
                                    root.q-y = self.absolute-position.y + y;
                                    q-menu.show();
                                }
                            }
                        }
                    }
                    // total speed and the last minute
                    Rectangle {
                        height: 104px;
                        border-radius: Theme.r-card;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.stroke;
                        clip: true;
                        Path {
                            y: parent.height - 46px;
                            width: parent.width;
                            height: 46px;
                            viewbox-width: 100;
                            viewbox-height: 40;
                            commands: root.spark-area;
                            fill: #3b82f62e;
                            stroke: transparent;
                        }
                        Path {
                            y: parent.height - 46px;
                            width: parent.width;
                            height: 46px;
                            viewbox-width: 100;
                            viewbox-height: 40;
                            commands: root.spark-line;
                            fill: transparent;
                            stroke: Theme.primary;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 0px;
                            alignment: start;
                            SectionTitle {
                                text: @tr("TOTAL SPEED");
                            }
                            HRow {
                                spacing: 5px;
                                Text {
                                    text: root.speed-value;
                                    font-size: 24px * Theme.font-scale;
                                    font-weight: 600;
                                    color: Theme.text;
                                }
                                VerticalLayout {
                                    alignment: end;
                                    padding-bottom: 4px;
                                    Text {
                                        text: root.speed-unit;
                                        font-size: 12px * Theme.font-scale;
                                        font-weight: 500;
                                        color: Theme.muted;
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    NavItem {
                        icon: "gear";
                        text: @tr("Options");
                        clicked => {
                            root.open-settings(0);
                        }
                    }
                }
            }

            // ================================================ main area
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                // ---- toolbar
                Rectangle {
                    height: 56px;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.stroke;
                    }
                    HRow {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 2px;
                        VerticalLayout {
                            alignment: center;
                            HRow {
                                spacing: 2px;
                                TbBtn {
                                    icon: "batch";
                                    compact: root.win-w < 1320px;
                                    text: @tr("Batch");
                                    clicked => {
                                        root.add-batch();
                                    }
                                }
                                TbBtn {
                                    icon: "torrent";
                                    compact: root.win-w < 1320px;
                                    text: @tr("Torrent");
                                    clicked => {
                                        root.torrent();
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    TbSep { }
                                }
                                TbBtn {
                                    icon: "play";
                                    compact: root.win-w < 1150px;
                                    text: @tr("Resume");
                                    tint: Theme.green;
                                    enabled: root.can-resume;
                                    clicked => {
                                        root.resume(root.selected-id);
                                    }
                                }
                                TbBtn {
                                    icon: "pause";
                                    compact: root.win-w < 1150px;
                                    text: @tr("Stop");
                                    enabled: root.can-stop;
                                    clicked => {
                                        root.pause(root.selected-id);
                                    }
                                }
                                TbBtn {
                                    icon: "stopall";
                                    compact: root.win-w < 1150px;
                                    text: @tr("Stop All");
                                    clicked => {
                                        root.stop-all();
                                    }
                                }
                                TbBtn {
                                    icon: "delete";
                                    compact: root.win-w < 1150px;
                                    text: @tr("Delete");
                                    tint: Theme.red;
                                    enabled: root.selected-id >= 0;
                                    clicked => {
                                        root.delete(root.selected-id);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    TbSep { }
                                }
                                TbBtn {
                                    icon: "scheduler";
                                    compact: root.win-w < 1480px;
                                    text: @tr("Scheduler");
                                    clicked => {
                                        root.open-scheduler();
                                    }
                                }
                                TbBtn {
                                    icon: "limiter";
                                    compact: root.win-w < 1480px;
                                    text: @tr("Limiter");
                                    active: root.limiter-on;
                                    clicked => {
                                        root.open-limiter();
                                    }
                                }
                                TbBtn {
                                    icon: "grabber";
                                    compact: root.win-w < 1480px;
                                    text: @tr("Grabber");
                                    clicked => {
                                        root.grabber();
                                    }
                                }
                                TbBtn {
                                    icon: "playlist";
                                    compact: root.win-w < 1480px;
                                    text: @tr("Playlist");
                                    clicked => {
                                        root.playlist();
                                    }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 8px;
                        }
                        // search
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: root.win-w < 1100px ? 170px : root.win-w < 1300px ? 200px : 240px;
                                height: 34px;
                                border-radius: Theme.r-ctl;
                                background: Theme.input-bg;
                                border-width: 1px;
                                border-color: si.has-focus ? Theme.primary : Theme.stroke;
                                HRow {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 15px;
                                        Ico {
                                            y: (parent.height - 15px) / 2;
                                            kind: "search";
                                            width: 15px;
                                            height: 15px;
                                            tint: Theme.muted;
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        si := TextInput {
                                            width: parent.width;
                                            height: parent.height;
                                            vertical-alignment: center;
                                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                            single-line: true;
                                            text <=> root.search;
                                            color: Theme.text;
                                            font-size: 12.5px * Theme.font-scale;
                                            edited => {
                                                root.search-changed();
                                            }
                                        }
                                        if si.text == "": Text {
                                            width: parent.width;
                                            height: parent.height;
                                            vertical-alignment: center;
                                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                            text: @tr("Search downloads…");
                                            font-size: 12.5px * Theme.font-scale;
                                            color: Theme.muted;
                                        }
                                    }
                                    if root.search != "": Rectangle {
                                        width: 14px;
                                        Ico {
                                            y: (parent.height - 14px) / 2;
                                            kind: "close";
                                            width: 14px;
                                            height: 14px;
                                            tint: Theme.muted;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.search = "";
                                                root.search-changed();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            padding-left: 6px;
                            RoundBtn {
                                size: 34px;
                                icon: "more";
                                label: @tr("More");
                                label-above: false;
                                clicked => {
                                    root.page = "main";
                                    more-menu.show();
                                }
                            }
                        }
                    }
                }

                // ---- the list
                list-area := Rectangle {
                    vertical-stretch: 1;
                    // column widths (the name takes the rest)
                    property <length> w-size: 84px * Theme.font-scale;
                    property <length> w-progress: 150px * Theme.font-scale;
                    property <length> w-speed: 92px * Theme.font-scale;
                    property <length> w-eta: 84px * Theme.font-scale;
                    property <length> w-date: 128px * Theme.font-scale;
                    VerticalLayout {
                        spacing: 0px;
                        // column titles
                        Rectangle {
                            height: 34px;
                            background: Theme.bg;
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.stroke;
                            }
                            HRow {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 14px;
                                Rectangle {
                                    width: 30px;
                                }
                                ColHead {
                                    horizontal-stretch: 1;
                                    min-width: 120px;
                                    text: @tr("NAME");
                                    key: "name";
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                }
                                if root.cols.size: ColHead {
                                    width: list-area.w-size;
                                    text: @tr("SIZE");
                                    key: "size";
                                    right: true;
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                }
                                ColHead {
                                    width: list-area.w-progress;
                                    text: @tr("PROGRESS");
                                    key: "status";
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                }
                                if root.cols.speed: ColHead {
                                    width: list-area.w-speed;
                                    text: @tr("SPEED");
                                    key: "speed";
                                    right: true;
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                }
                                if root.cols.eta: ColHead {
                                    width: list-area.w-eta;
                                    text: @tr("TIME LEFT");
                                    key: "eta";
                                    right: true;
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                }
                                if root.cols.last: ColHead {
                                    width: list-area.w-date;
                                    text: @tr("DATE");
                                    key: "date";
                                    right: true;
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                }
                                Rectangle {
                                    width: 30px;
                                }
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for r in root.rows: ListRow {
                                data: r;
                                selected: r.sel;
                                queues: root.queues;
                                sel-count: root.sel-count;
                                cols: root.cols;
                                w-size: list-area.w-size;
                                w-progress: list-area.w-progress;
                                w-speed: list-area.w-speed;
                                w-eta: list-area.w-eta;
                                w-date: list-area.w-date;
                                pick(ctrl, shift) => {
                                    root.row-clicked(r.id, ctrl, shift);
                                    keys.focus();
                                }
                                right-pick => {
                                    root.row-right(r.id);
                                }
                                activated => {
                                    root.row-activated(r.id);
                                }
                                action(a) => {
                                    root.row-action(r.id, a);
                                }
                                move-to-queue(q) => {
                                    root.row-to-queue(r.id, q);
                                }
                                drag-out => {
                                    root.row-drag-out(r.id);
                                }
                            }
                        }
                    }
                    // nothing to show
                    if root.rows.length == 0: VerticalLayout {
                        y: 34px;
                        height: parent.height - 34px;
                        alignment: center;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 16px;
                                background: Theme.select;
                                Ico {
                                    kind: root.search != "" ? "search" : "download";
                                    width: 30px;
                                    height: 30px;
                                    tint: Theme.primary;
                                }
                            }
                        }
                        Text {
                            text: root.search != "" ? @tr("Nothing matches “{}”.", root.search) : @tr("No downloads yet");
                            horizontal-alignment: center;
                            font-size: 15px * Theme.font-scale;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        if root.search == "": Text {
                            text: @tr("Paste a link, click “New download”, or download something in your browser.");
                            horizontal-alignment: center;
                            font-size: 12.5px * Theme.font-scale;
                            color: Theme.muted;
                        }
                        if root.search == "": HorizontalLayout {
                            alignment: center;
                            padding-top: 6px;
                            Button {
                                text: @tr("New download");
                                primary: true;
                                clicked => {
                                    root.add-url();
                                }
                            }
                        }
                    }
                }

                // ---- status bar
                Rectangle {
                    height: 34px;
                    background: Theme.side;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.stroke;
                    }
                    HRow {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;
                        Pill {
                            icon: "download";
                            state: root.running-count > 0 ? "blue" : "";
                            text: root.speed-value + " " + root.speed-unit;
                        }
                        Pill {
                            state: root.running-count > 0 ? "ok" : "";
                            text: root.running-count > 0 ? @tr("{} downloading", root.running-count) : @tr("Idle");
                        }
                        Pill {
                            icon: "check";
                            text: @tr("Today: {} · {}", root.today-count, root.today-bytes);
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        if root.all-done != 0: Pill {
                            icon: "power";
                            state: "warn";
                            text: root.done-text(root.all-done);
                            clickable: true;
                            clicked => {
                                root.set-all-done(0);
                            }
                        }
                        Pill {
                            icon: "limiter";
                            state: root.limiter-on ? "warn" : "";
                            text: root.limiter-on ? root.limiter-text : @tr("No speed limit");
                            clickable: true;
                            clicked => {
                                root.toggle-limiter();
                            }
                        }
                        Pill {
                            icon: "browser";
                            state: root.browser-on ? "ok" : "";
                            text: root.browser-on ? @tr("Browser connected") : @tr("Browser not connected");
                            clickable: true;
                            clicked => {
                                root.browsers();
                            }
                        }
                    }
                }
            }
        }
    }
}


// ------------------------------------------------------------------ dialogs

// "Download File Info" – shown for every new download.
export component AddDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download File Info");
    preferred-width: 640px;
    min-width: 540px;

    in-out property <string> url;
    // full path: folder + file name
    in-out property <string> save-as;
    in-out property <string> description;
    in-out property <int> connections: 32;
    in-out property <int> category-index: 0;
    in-out property <bool> remember-path;
    in property <string> category-name: "General";
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> size-text;
    in property <string> info;
    in property <bool> probing;
    in property <bool> info-error;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in property <[string]> category-names: ["General", "Compressed", "Documents", "Music", "Programs", "Video", "Images"];
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    // a warning about the address (web page, duplicate...)
    in property <string> warning;
    // the server refused EdsDown: offer the browser instead
    in property <bool> can-use-browser;
    callback use-browser();

    callback check-url();
    callback category-changed(int);
    callback browse();
    callback start-now();
    callback later();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HRow {
            spacing: 14px;
            GridLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 0;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("URL");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 0;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.url;
                        placeholder-text: @tr("https://example.com/file");
                        horizontal-stretch: 1;
                        accepted(t) => {
                            root.check-url();
                        }
                    }
                    Button {
                        text: @tr("Check");
                        clicked => {
                            root.check-url();
                        }
                    }
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 1;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Category");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 1;
                    ComboBox {
                        width: 200px;
                        model: root.category-names;
                        current-index <=> root.category-index;
                        selected(v) => {
                            root.category-changed(root.category-index);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 2;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Save As");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 2;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.save-as;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "…";
                        clicked => {
                            root.browse();
                        }
                    }
                }
                Rectangle {
                    col: Theme.rtl ? 1 : 0;
                    row: 3;
                }
                CheckBox {
                    col: Theme.rtl ? 0 : 1;
                    row: 3;
                    text: @tr("Remember this path for \"{}\" category", root.category-name);
                    checked <=> root.remember-path;
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 4;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Description");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    col: Theme.rtl ? 0 : 1;
                    row: 4;
                    text <=> root.description;
                    placeholder-text: @tr("optional note");
                }
            }
            VerticalLayout {
                width: 110px;
                spacing: 6px;
                alignment: start;
                padding-top: 4px;
                BigTypeIcon {
                    kind: root.kind;
                    ext: root.ext;
                }
                Text {
                    text: root.size-text;
                    horizontal-alignment: center;
                    font-size: 12px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Use authorization");
                checked <=> root.use-login;
            }
            if root.use-login: Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Login");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.user;
                horizontal-stretch: 1;
            }
            if root.use-login: Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Password");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                horizontal-stretch: 1;
            }
            if !root.use-login: Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.warning != "": GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 6px;
            Glyph {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: "warn";
            }
            Text {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.warning;
                color: Theme.warn;
                wrap: word-wrap;
                font-size: 12px * Theme.font-scale;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 32px;
            border-width: 1px;
            border-color: root.info-error ? Theme.err : Theme.line;
            background: Theme.panel;
            border-radius: Theme.r-panel;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                text: root.probing ? @tr("Checking the address…") : root.info;
                color: root.info-error ? Theme.err : Theme.muted;
                overflow: elide;
                font-size: 12px * Theme.font-scale;
            }
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Connections");
                vertical-alignment: center;
                color: Theme.text;
            }
            SpinBox {
                width: 110px;
                minimum: 1;
                maximum: 32;
                value <=> root.connections;
            }
            Rectangle {
                width: 10px;
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            ComboBox {
                model: root.queue-names;
                current-index <=> root.queue-index;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HRow {
            spacing: 8px;
            alignment: end;
            if root.can-use-browser: Button {
                text: @tr("Download with the browser");
                clicked => {
                    root.use-browser();
                }
            }
            if root.can-use-browser: Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Download Later");
                enabled: root.url != "";
                clicked => {
                    root.later();
                }
            }
            Button {
                text: @tr("Start Download");
                primary: true;
                enabled: root.url != "";
                clicked => {
                    root.start-now();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 30px;
    width: label.preferred-width + 28px;
    border-radius: 15px;
    background: root.active ? Theme.chip-on : ta.has-hover ? Theme.btn-hover : Theme.btn;
    border-width: 1px;
    border-color: root.active ? Theme.chip-on-line : Theme.stroke;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: 600;
        color: root.active ? Theme.chip-on-text : Theme.text;
    }
}

export component BatchDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add batch download");
    preferred-width: 640px;
    preferred-height: 520px;

    // 0: list of links, 1: address with a * pattern
    in-out property <int> mode: 0;
    in-out property <string> links;
    in-out property <string> folder;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in-out property <bool> start-now: true;
    in property <string> message;
    // pattern
    in-out property <string> pattern;
    in-out property <bool> letters;
    in-out property <string> from-text: "1";
    in-out property <string> to-text: "10";
    in-out property <int> wildcard-size: 1;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> preview;

    callback paste();
    callback browse();
    callback pattern-changed();
    callback ok();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("List of links");
                active: root.mode == 0;
                clicked => {
                    root.mode = 0;
                }
            }
            TabButton {
                text: @tr("Address with a pattern (*)");
                active: root.mode == 1;
                clicked => {
                    root.mode = 1;
                    root.pattern-changed();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.mode == 0: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Paste the links, one per line. They download one after another in the queue you choose.");
                wrap: word-wrap;
                color: Theme.text;
            }
            TextEdit {
                text <=> root.links;
                vertical-stretch: 1;
                min-height: 200px;
                font-size: 12px * Theme.font-scale;
            }
            HRow {
                spacing: 6px;
                Button {
                    text: @tr("Paste from clipboard");
                    clicked => {
                        root.paste();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        if root.mode == 1: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Type an address with a * where the number (or letter) goes, for example\nhttps://www.site.com/pictures/img*.jpg");
                wrap: word-wrap;
                color: Theme.text;
            }
            LineEdit {
                text <=> root.pattern;
                placeholder-text: @tr("https://www.site.com/pictures/img*.jpg");
                edited(t) => {
                    root.pattern-changed();
                }
            }
            HRow {
                spacing: 16px;
                CheckBox {
                    text: @tr("Letters (a-z) instead of numbers");
                    checked <=> root.letters;
                    toggled => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("From");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.from-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("To");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.to-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Wildcard size");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    maximum: 10;
                    value <=> root.wildcard-size;
                    edited(v) => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Wildcard size 3 makes 001, 002 … 010.");
                color: Theme.muted;
                font-size: 11px * Theme.font-scale;
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Login");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.user;
                    placeholder-text: @tr("optional");
                    horizontal-stretch: 1;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Password");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 80px;
                background: Theme.panel;
                border-radius: Theme.r-panel;
                border-width: 1px;
                border-color: Theme.line;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    text: root.preview;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                ComboBox {
                    model: root.queue-names;
                    current-index <=> root.queue-index;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 1;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Save all to");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 1;
                spacing: 6px;
                LineEdit {
                    text <=> root.folder;
                    placeholder-text: @tr("automatic (by file type)");
                    horizontal-stretch: 1;
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
        }
        CheckBox {
            text: @tr("Start the queue now");
            checked <=> root.start-now;
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Add");
                primary: true;
                clicked => {
                    root.ok();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// The per-download progress window (tabs like a classic download manager).
export component DetailsDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.percent + " " + root.name;
    preferred-width: 500px;
    min-width: 440px;
    // the Windows title bar: a window drawn without it answered the mouse
    // in the wrong place on some Windows 10 / 11 computers

    in property <string> name;
    in property <string> percent;
    in property <string> url;
    in property <string> status;
    in property <string> size;
    in property <string> downloaded;
    in property <string> speed;
    in property <string> eta;
    in property <string> resumable;
    in property <bool> resumable-ok;
    in property <string> error;
    in property <string> kind: "general";
    in property <float> progress;
    in property <int> state;
    in property <[SegView]> segs;
    in-out property <bool> show-details: false;
    in-out property <int> tab: 0;
    // speed limiter tab
    in-out property <bool> limit-on;
    in-out property <int> limit-kb: 500;
    // options on completion tab
    in-out property <int> when-done: 0;
    in-out property <bool> complete-dialog: true;
    in-out property <bool> force-close;

    callback pause();
    callback resume();
    callback cancel-download();
    callback close-window();
    callback hide-to-tray();
    callback limit-changed();
    callback completion-changed();
    // "Hide details" / "Show details": the window takes the size it needs
    out property <length> content-height: outer.preferred-height;
    callback details-toggled();

    outer := VerticalLayout {
      padding: 0px;
      spacing: 0px;
      VerticalLayout {
        padding: 10px;
        spacing: 0px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("Download status");
                active: root.tab == 0;
                clicked => {
                    root.tab = 0;
                }
            }
            TabButton {
                text: @tr("Speed Limiter");
                active: root.tab == 1;
                clicked => {
                    root.tab = 1;
                }
            }
            TabButton {
                text: @tr("Options on completion");
                active: root.tab == 2;
                clicked => {
                    root.tab = 2;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            background: Theme.panel;
            border-radius: Theme.r-panel;
            border-width: 1px;
            border-color: Theme.line;
            min-height: 150px;
            if root.tab == 0: VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    TypeIcon {
                        kind: root.kind;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        // a long name is cut ("…"), it never makes the window wider
                        min-width: 0px;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        font-size: 11px * Theme.font-scale;
                        overflow: elide;
                        color: Theme.accent;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.grid;
                }
                VerticalLayout {
                    spacing: 2px;
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Status");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.status;
                            color: root.state == 4 ? Theme.err : Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("File size");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.size;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Downloaded");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.downloaded;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Transfer rate");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.speed;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Time left");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.eta;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Resume capability");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.resumable;
                            color: root.resumable-ok ? Theme.ok : Theme.err;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
                if root.error != "": Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.error;
                    color: Theme.err;
                    wrap: word-wrap;
                    font-size: 11px * Theme.font-scale;
                }
            }
            if root.tab == 1: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Transfer rate");
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.speed;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: @tr("Use speed limiter for this download");
                    checked <=> root.limit-on;
                    toggled => {
                        root.limit-changed();
                    }
                }
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Maximum download speed (KB/s)");
                        color: root.limit-on ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 140px;
                        enabled: root.limit-on;
                        minimum: 1;
                        maximum: 1000000;
                        step-size: 50;
                        value <=> root.limit-kb;
                        edited(v) => {
                            root.limit-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HRow {
                    spacing: 6px;
                    for kb in [128, 256, 512, 1024, 2048, 5120]: Button {
                        text: kb >= 1024 ? @tr("{} MB/s", kb / 1024) : @tr("{} KB/s", kb);
                        clicked => {
                            root.limit-on = true;
                            root.limit-kb = kb;
                            root.limit-changed();
                        }
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Changes apply right away, even while downloading.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                }
            }
            if root.tab == 2: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("When this download completes:");
                    color: Theme.text;
                }
                ComboBox {
                    width: 300px;
                    model: [@tr("Do nothing (keep the computer on)"), @tr("Shut down the computer"), @tr("Sleep"), @tr("Exit EdsDown"), @tr("Hibernate")];
                    current-index <=> root.when-done;
                    selected(v) => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Force programs to close when shutting down");
                    checked <=> root.force-close;
                    enabled: root.when-done == 1;
                    toggled => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show the \"Download complete\" window");
                    checked <=> root.complete-dialog;
                    toggled => {
                        root.completion-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("You get 30 seconds to cancel before the computer shuts down, sleeps or hibernates.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        Bar {
            height: 8px;
            value: root.progress;
            tint: Theme.primary;
        }
        Rectangle {
            height: 8px;
        }
        HRow {
            spacing: 8px;
            Button {
                text: root.show-details ? @tr("<< Hide details") : @tr("Show details >>");
                clicked => {
                    root.show-details = !root.show-details;
                    root.details-toggled();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // the window goes, a small icon with the progress stays next to the clock
            if root.state != 3: Button {
                text: @tr("Next to the clock");
                clicked => {
                    root.hide-to-tray();
                }
            }
            if root.state == 0 || root.state == 1: Button {
                text: @tr("Pause");
                clicked => {
                    root.pause();
                }
            }
            if root.state == 2 || root.state == 4: Button {
                text: @tr("Resume");
                primary: true;
                clicked => {
                    root.resume();
                }
            }
            Button {
                text: root.state == 3 ? @tr("Close") : @tr("Cancel");
                clicked => {
                    if (root.state == 3) {
                        root.close-window();
                    } else {
                        root.cancel-download();
                    }
                }
            }
        }
        if root.show-details: VerticalLayout {
            spacing: 6px;
            padding-top: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Start positions and download progress by connections");
                font-size: 11px * Theme.font-scale;
                color: Theme.muted;
            }
            Rectangle {
                height: 16px;
                background: Theme.track;
                border-radius: 8px;
                clip: true;
                for s in root.segs: Rectangle {
                    x: parent.width * s.start;
                    y: 0;
                    width: parent.width * (s.done - s.start);
                    height: parent.height;
                    background: s.busy ? #60a5fa : Theme.primary;
                    animate width {
                        duration: 100ms;
                        easing: linear;
                    }
                }
                for s in root.segs: Rectangle {
                    x: parent.width * s.start;
                    y: 0;
                    width: 1.5px;
                    height: parent.height;
                    background: Theme.bg-a;
                }
            }
            Rectangle {
                height: 150px;
                background: Theme.panel;
                border-radius: Theme.r-panel;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 1px;
                    Rectangle {
                        height: 22px;
                        background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                        HRow {
                            HeaderCell {
                                text: @tr("N.");
                                width: 34px;
                            }
                            HeaderCell {
                                text: @tr("Downloaded");
                                width: 110px;
                            }
                            HeaderCell {
                                text: @tr("Info");
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for s in root.segs: Rectangle {
                            height: 19px;
                            HRow {
                                Cell {
                                    text: s.number;
                                    width: 34px;
                                    horizontal-alignment: center;
                                }
                                Cell {
                                    text: " " + s.downloaded;
                                    width: 110px;
                                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                }
                                Cell {
                                    text: s.info;
                                    horizontal-stretch: 1;
                                    color: s.busy ? Theme.accent : Theme.muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}

export component CompleteDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download complete");
    preferred-width: 540px;

    in property <string> name;
    in property <string> size;
    in property <string> path;
    in property <string> url;
    in property <string> kind: "general";
    in property <string> ext;
    in-out property <bool> dont-show;

    callback open-file();
    callback open-with();
    callback open-folder();
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 16px;
            BigTypeIcon {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: root.kind;
                ext: root.ext;
            }
            VerticalLayout {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Download complete");
                    font-size: 15px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.ok;
                }
                GridLayout {
                    spacing: 6px;
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Address");
                        color: Theme.muted;
                    }
                    Text {
                        // a long name is cut ("…"), it never makes the window wider
                        min-width: 0px;
                        col: Theme.rtl ? 0 : 1;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        overflow: elide;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.accent;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("File size");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.size;
                        color: Theme.text;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Saved as");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.path;
                        wrap: word-wrap;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.text;
                    }
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Don't show this again");
                checked <=> root.dont-show;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Open");
                primary: true;
                clicked => {
                    root.open-file();
                }
            }
            // no "Open with…" here: picked by mistake it changes which
            // program opens this kind of file (still in the list's menu)
            Button {
                text: @tr("Open folder");
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
