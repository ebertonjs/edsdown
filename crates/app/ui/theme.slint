// EdsDown – colors and sizes: one professional dark theme (flat slate
// surfaces, a single blue accent, Inter).

export global Theme {
    in-out property <int> mode: 9;
    out property <bool> dark: true;
    // kept for windows written for the earlier looks (always on)
    out property <bool> netlab: true;
    // Options > Appearance > Text size / Font
    in-out property <float> font-scale: 1.0;
    // false when the windows are drawn by the processor: it can't round a
    // gradient, so rounded buttons use one plain color there
    in-out property <bool> gradients: true;
    in-out property <string> font-family: "";
    // the program's language is written in Latin letters (Inter has no
    // Cyrillic / Arabic here)
    in-out property <bool> latin: true;
    // a picture behind the main window: how much of it shows through (0..0.8)
    in-out property <float> glass-strength: 0;
    // Arabic: every window reads from right to left
    in-out property <bool> rtl: false;

    // ---- EdsDown Pro: flat dark slate, one blue accent
    // surfaces
    out property <color> bg: #0b1220;
    out property <color> bg-a: bg;
    out property <color> bg-b: bg;
    out property <color> surface: #111a2e;
    out property <color> surface-2: #16213a;
    out property <color> surface-3: #1c2945;
    out property <color> text: #e6edf7;
    out property <color> text-2: #b6c2d6;
    out property <color> muted: #8a98b3;
    out property <color> glass: surface;
    out property <color> glass-2: surface-2;
    out property <color> glass-hi: #ffffff0a;
    out property <color> side: #0e1626;
    out property <color> side-text: text;
    out property <color> stroke: #23304a;
    out property <color> stroke-2: #2e3d5c;
    out property <color> rule: #1e2a42;
    out property <color> shadow: #00000059;
    out property <color> btn: surface-2;
    out property <color> btn-hover: surface-3;
    out property <color> btn-press: #22325a;
    out property <color> btn-ico: #c5d0e3;
    out property <color> track: #1f2a40;
    out property <color> tile: surface;
    out property <color> tooltip: #050a14f2;
    out property <color> tooltip-text: #ffffff;
    // the one accent
    out property <color> primary: #3b82f6;
    out property <color> primary-hover: #4c8ef7;
    out property <color> primary-press: #2563eb;
    out property <color> on-primary: #ffffff;
    out property <color> chip-on: #3b82f626;
    out property <color> chip-on-line: #3b82f6;
    out property <color> chip-on-text: #e6edf7;
    // states and file types
    out property <color> blue: primary;
    out property <color> orange: #f59e0b;
    out property <color> green: #22c55e;
    out property <color> red: #ef4444;
    out property <color> purple: #a78bfa;
    out property <length> r-card: 10px;
    out property <length> r-panel: 10px;
    out property <length> r-ctl: 8px;

    // ---- names the dialogs use
    out property <color> window: bg;
    out property <color> panel: surface;
    out property <color> toolbar-top: side;
    out property <color> toolbar-bottom: side;
    out property <color> toolbar-text: text;
    out property <color> toolbar-hover: btn-hover;
    out property <color> line: stroke;
    out property <color> grid: surface;
    out property <color> header-top: surface-2;
    out property <color> header-bottom: surface-2;
    out property <color> accent: primary;
    out property <color> select: #3b82f624;
    out property <color> select-line: #3b82f6;
    out property <color> hover: #ffffff08;
    out property <color> ok: green;
    out property <color> warn: orange;
    out property <color> err: red;
    out property <color> bar-bg: track;
    out property <color> input-bg: #0e1626;
}
