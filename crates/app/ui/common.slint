// EdsDown – shared look: data types, the NetLAB widgets, icons.

import { LineEdit, SpinBox, ComboBox, ListView, TabWidget, TextEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Ico, Kinds, KindBadge, RoundBtn, Pill, Chip, Glass, SectionTitle, Bar } from "nl.slint";
export { Theme, Ico, Kinds, KindBadge, RoundBtn, Pill, Chip, Glass, SectionTitle, Bar }
// Inter, the font of NetNOC (SIL Open Font License, fonts/LICENSE-Inter-OFL.txt)
import "fonts/Inter-400.ttf";
import "fonts/Inter-500.ttf";
import "fonts/Inter-600.ttf";
import "fonts/Inter-700.ttf";

export struct DownloadRow {
    id: int,
    name: string,
    // file type icon: video, audio, archive, pdf, doc, sheet, slides, text, exe, apk, disc, image, general
    kind: string,
    category: string,
    queue: string,
    size: string,
    status: string,
    progress: float,
    eta: string,
    speed: string,
    last-try: string,
    description: string,
    added: string,
    // part of the multiple selection (Ctrl / Shift click, Ctrl+A)
    sel: bool,
    save-to: string,
    referer: string,
    parent: string,
    // 0 queued, 1 running, 2 paused, 3 complete, 4 error
    state: int,
}

// a column of the download list, in the order shown (drag to move / resize)
export struct ColDef {
    key: string,
    width: length,
}

// which list columns are visible (View > Columns)
export struct Cols {
    q: bool,
    size: bool,
    status: bool,
    eta: bool,
    speed: bool,
    last: bool,
    desc: bool,
    added: bool,
    saveto: bool,
    referer: bool,
    parent: bool,
}

// a category in the sidebar
export struct CatRow {
    name: string,
    // the name in the current language
    label: string,
    // icon kind
    kind: string,
    count: string,
    unfinished: string,
    finished: string,
    builtin: bool,
}

// one row of a simple two/three column list (logins, server exceptions...)
export struct PairRow {
    a: string,
    b: string,
    c: string,
}

// a file found by the site grabber / "download all links"
export struct LinkRow {
    checked: bool,
    name: string,
    kind: string,
    ext: string,
    text: string,
    url: string,
}

export struct QueueRow {
    id: int,
    name: string,
    count: int,
    running: bool,
}

// one connection of a download (progress window)
export struct SegView {
    // this connection is receiving right now
    busy: bool,
    start: float,
    done: float,
    number: string,
    downloaded: string,
    info: string,
}


// Applies the light/dark look to the standard widgets of every window.
export component ThemedWindow inherits Window {
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    // NetNOC's indigo (or blue-grey) gradient behind every window
    background: @linear-gradient(160deg, Theme.bg-a 0%, Theme.bg-b 100%);
    default-font-size: 12px * Theme.font-scale;
    default-font-family: Theme.font-family != "" ? Theme.font-family : Theme.latin ? "Inter" : "";
    icon: @image-url("icon-window.png");
}

// ---- buttons and check boxes in the NetLAB look (same use as the standard ones)
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // the main button of a window: orange
    in property <bool> primary;
    callback clicked();
    min-width: max(80px, label.preferred-width + 30px);
    height: 32px;
    horizontal-stretch: 0;
    border-radius: 16px;
    background: root.primary ? @linear-gradient(135deg, #f59e2e 0%, #ffc56b 100%)
        : ta.pressed ? Theme.btn-press : ta.has-hover ? Theme.btn-hover : Theme.btn;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    drop-shadow-blur: root.primary && root.enabled ? 12px : 0px;
    drop-shadow-color: root.primary && root.enabled ? #f59e2e4d : transparent;
    drop-shadow-offset-y: root.primary && root.enabled ? 3px : 0px;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        text: root.text;
        font-size: 12px * Theme.font-scale;
        font-weight: 600;
        color: root.primary ? #2a1600 : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    min-height: 26px;
    min-width: box.width + (root.text != "" ? txt.preferred-width + 10px : 0px);
    preferred-width: self.min-width;
    opacity: root.enabled ? 1.0 : 0.45;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    box := Rectangle {
        x: 0;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 6px;
        background: root.checked ? @linear-gradient(135deg, #f59e2e 0%, #ffc56b 100%) : ta.has-hover && root.enabled ? Theme.btn-hover : Theme.btn;
        border-width: root.checked ? 0px : 1.5px;
        border-color: Theme.dark ? #ffffff40 : #1c233340;
        if root.checked: Ico {
            kind: "check";
            width: 14px;
            height: 14px;
            tint: #2a1600;
            weight: 3;
        }
    }
    txt := Text {
        x: 28px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        color: Theme.text;
        font-size: 12px * Theme.font-scale;
        wrap: word-wrap;
    }
}

// Small icons for menus, lists and buttons (old name; drawn by Ico now).
export component Glyph inherits Rectangle {
    in property <string> kind;
    in property <color> tint: Theme.text;
    width: 16px;
    height: 16px;
    Ico {
        kind: root.kind;
        tint: root.tint;
        width: parent.width;
        height: parent.height;
        weight: 2.1;
    }
}

// ------------------------------------------------------------------ icons

export component P inherits Path {
    viewbox-width: 32;
    viewbox-height: 32;
}

// Toolbar icons (old name; line icons now).
export component Icon inherits Rectangle {
    in property <string> kind;
    width: 32px;
    height: 32px;
    Ico {
        kind: root.kind;
        tint: root.kind == "add" ? Theme.orange : root.kind == "delete" || root.kind == "stopall" ? Theme.red : Theme.btn-ico;
        width: parent.width;
        height: parent.height;
    }
}

export component G inherits Path {
    viewbox-width: 16;
    viewbox-height: 16;
}

// File type icon (old name): the tinted NetLAB badge.
export component TypeIcon inherits Rectangle {
    in property <string> kind: "general";
    width: 18px;
    height: 18px;
    KindBadge {
        kind: root.kind;
        width: parent.width;
        height: parent.height;
    }
}

// Big icon with the file extension under it (dialogs).
export component BigTypeIcon inherits VerticalLayout {
    in property <string> kind;
    in property <string> ext;
    spacing: 4px;
    alignment: start;
    HorizontalLayout {
        alignment: center;
        TypeIcon {
            kind: root.kind;
            width: 48px;
            height: 48px;
        }
    }
    Text {
        text: root.ext;
        horizontal-alignment: center;
        font-size: 11px * Theme.font-scale;
        font-weight: 700;
        color: Theme.muted;
    }
}

// ------------------------------------------------------------------ main window parts

export component ToolBtn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> enabled: true;
    // View > Toolbar > Small buttons: icon only
    in property <bool> small;
    callback clicked();
    // small buttons: every one fits a 960 px wide window
    width: root.small ? 34px : 56px;
    height: root.small ? 34px : 52px;
    border-radius: Theme.netlab ? 10px : 3px;
    border-width: ta.has-hover && root.enabled ? 1px : 0px;
    border-color: Theme.select-line;
    background: !root.enabled ? transparent : ta.pressed ? Theme.select : ta.has-hover ? Theme.toolbar-hover : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    if !root.small: VerticalLayout {
        alignment: center;
        spacing: 3px;
        padding-left: 1px;
        padding-right: 1px;
        opacity: root.enabled ? 1.0 : 0.35;
        HorizontalLayout {
            alignment: center;
            Icon {
                width: 26px;
                height: 26px;
                kind: root.icon;
            }
        }
        // a long name ends in "…" ("Delete C…")
        Text {
            text: root.text;
            font-size: 10px * Theme.font-scale;
            // bold, so the names read well on every theme
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
            color: Theme.toolbar-text;
        }
    }
    if root.small: Icon {
        x: (parent.width - 24px) / 2;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        kind: root.icon;
        opacity: root.enabled ? 1.0 : 0.35;
    }
}

export component ToolSeparator inherits Rectangle {
    width: 7px;
    Rectangle {
        x: 3px;
        y: 8px;
        width: 1px;
        height: parent.height - 16px;
        background: Theme.line;
    }
}

export component TreeItem inherits Rectangle {
    in property <string> text;
    // "folder", "queue", "unfinished", "finished" or a file kind
    in property <string> icon;
    in property <string> count;
    in property <int> indent;
    in property <bool> selected;
    in property <bool> bold;
    // a branch that opens / closes (+ / - in front)
    in property <bool> expandable;
    in property <bool> expanded;
    callback clicked();
    callback toggle();
    // right click, at this position inside the item
    callback context(length, length);
    height: 23px;
    background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.select-line;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.toggle();
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.clicked();
                root.context(self.mouse-x, self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 4px + root.indent * 16px;
        padding-right: 6px;
        spacing: 5px;
        Rectangle {
            width: 11px;
            if root.expandable: Rectangle {
                y: (parent.height - 11px) / 2;
                width: 11px;
                height: 11px;
                border-width: 1px;
                border-color: Theme.muted;
                background: Theme.panel;
                Rectangle {
                    x: 2px;
                    y: 5px;
                    width: 7px;
                    height: 1px;
                    background: Theme.text;
                }
                if !root.expanded: Rectangle {
                    x: 5px;
                    y: 2px;
                    width: 1px;
                    height: 7px;
                    background: Theme.text;
                }
                TouchArea {
                    clicked => {
                        root.toggle();
                    }
                }
            }
        }
        Rectangle {
            width: 16px;
            if root.icon == "folder": Icon {
                kind: "folder";
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "queue": Icon {
                kind: "startqueue";
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "unfinished": Glyph {
                kind: "down";
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "finished": Glyph {
                kind: "check";
                tint: Theme.ok;
                y: (parent.height - 16px) / 2;
            }
            if root.icon != "folder" && root.icon != "queue" && root.icon != "unfinished" && root.icon != "finished": TypeIcon {
                kind: root.icon;
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            color: Theme.text;
            font-size: 12px * Theme.font-scale;
            font-weight: root.bold ? 600 : 400;
        }
        Text {
            text: root.count;
            vertical-alignment: center;
            color: Theme.muted;
            font-size: 11px * Theme.font-scale;
        }
    }
}

export component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <TextHorizontalAlignment> align: left;
    // sorting: this column's key, the current key and direction
    in property <string> key;
    in property <string> sort-by;
    in property <bool> sort-desc;
    // drag the right edge to resize, drag the title to move it
    in property <bool> adjustable;
    callback sort(string);
    // the new width while the edge is dragged; done when it is let go
    callback resized(length);
    callback resize-done();
    // the title was dragged and let go at `x` (in the header)
    callback dropped(length);
    property <bool> moving;
    property <length> start-width;
    property <length> start-x;
    height: 24px;
    background: root.moving ? Theme.select : ta.has-hover && (root.key != "" || root.adjustable) ? Theme.hover : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.key != "" || root.adjustable;
        mouse-cursor: root.moving ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.moving = false;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && root.moving) {
                root.dropped(root.x + self.mouse-x);
            }
        }
        moved => {
            if (root.adjustable && self.pressed && abs(self.mouse-x - self.pressed-x) > 10px) {
                root.moving = true;
            }
        }
        clicked => {
            if (!root.moving && root.key != "") {
                root.sort(root.key);
            }
            root.moving = false;
        }
    }
    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.text;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        color: Theme.text;
        overflow: elide;
    }
    if root.key != "" && root.key == root.sort-by: Glyph {
        x: root.align == TextHorizontalAlignment.right ? 2px : parent.width - 16px;
        y: (parent.height - 16px) / 2;
        kind: root.sort-desc ? "caret-down" : "caret-up";
        tint: Theme.muted;
    }
    Rectangle {
        x: parent.width - 1px;
        y: 4px;
        width: 1px;
        height: parent.height - 8px;
        background: Theme.line;
    }
    // the edge to resize the column
    if root.adjustable: edge := TouchArea {
        x: parent.width - 5px;
        width: 8px;
        height: parent.height;
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.start-width = root.width;
                root.start-x = self.absolute-position.x + self.mouse-x;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                root.resize-done();
            }
        }
        moved => {
            if (self.pressed) {
                // measured on the screen: the edge itself moves with the column
                root.resized(max(36px, root.start-width + self.absolute-position.x + self.mouse-x - root.start-x));
            }
        }
    }
}

export component Cell inherits Text {
    vertical-alignment: center;
    font-size: 12px * Theme.font-scale;
    color: Theme.text;
    overflow: elide;
}

// ---- menu pieces (popups)
export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <color> glyph-color: Theme.btn-ico;
    in property <bool> enabled: true;
    in property <bool> bold;
    in property <bool> indent;
    // a check mark on the right (chosen option)
    in property <bool> checked;
    callback clicked();
    height: 32px;
    border-radius: 10px;
    background: ta.has-hover && root.enabled ? Theme.btn-hover : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: root.indent ? 28px : 10px;
        padding-right: 10px;
        spacing: 10px;
        opacity: root.enabled ? 1.0 : 0.4;
        Rectangle {
            width: 16px;
            if root.glyph != "": Glyph {
                y: (parent.height - 16px) / 2;
                kind: root.glyph;
                tint: root.glyph-color;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            font-size: 12px * Theme.font-scale;
            font-weight: root.bold ? 600 : 400;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.checked: Glyph {
            y: (parent.height - 16px) / 2;
            kind: "check";
            tint: Theme.blue;
        }
    }
}

export component MenuSep inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.rule;
    }
}

export component MenuLabel inherits Rectangle {
    in property <string> text;
    height: 26px;
    Text {
        x: 12px;
        text: root.text;
        font-size: 10.5px * Theme.font-scale;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: Theme.muted;
        vertical-alignment: center;
        height: parent.height;
    }
}

// The frame of every popup menu.
export component MenuFrame inherits Rectangle {
    border-radius: 16px;
    background: Theme.dark ? #23253ef7 : #f4f7fbf7;
    border-width: 1px;
    border-color: Theme.stroke;
    drop-shadow-blur: 26px;
    drop-shadow-color: #05061480;
    drop-shadow-offset-y: 10px;
}
